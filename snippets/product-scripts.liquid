
    <script>
        function toggleModalTrigger() {
            const productImg = document.getElementById('productImg');
            if (window.innerWidth <= 768) {
                productImg.setAttribute('data-bs-toggle', 'modal');
                productImg.setAttribute('data-bs-target', '#cartModal');
            } else {
                productImg.removeAttribute('data-bs-toggle');
                productImg.removeAttribute('data-bs-target');
            }
        }

        window.addEventListener('load', toggleModalTrigger);
        window.addEventListener('resize', toggleModalTrigger);
    </script>

