    <script>
            let swiperLeftCart;
        let swiperRightCart;
        let isMobile = window.innerWidth <= 1025;

        function initSwipers() {
            if (!isMobile) {
                // create left/thumb swiper and expose globally
                swiperLeftCart = new Swiper(".swiperCartLeft", {
                    direction: "vertical",
                    spaceBetween: 10,
                    slidesPerView: 4,
                    freeMode: true,
                    watchSlidesProgress: true,
                });
                window.swiperLeftCart = swiperLeftCart;
            } else {
                // ensure global reference is null on mobile
                window.swiperLeftCart = null;
                swiperLeftCart = null;
            }

            // create right/main swiper and expose globally
            swiperRightCart = new Swiper(".swiperCartRight", {
                spaceBetween: 0,
                slidesPerView: 1,
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },
                thumbs: {
                    // When not mobile, attach the left swiper (may be null on mobile)
                    swiper: swiperLeftCart || null,
                },
            });
            window.swiperRightCart = swiperRightCart;
        }

        function destroySwipers() {
            if (window.swiperLeftCart) {
                try {
                    window.swiperLeftCart.destroy(true, true);
                } catch (e) { console.warn(e); }
                window.swiperLeftCart = null;
                swiperLeftCart = null;
            }

            if (window.swiperRightCart) {
                try {
                    window.swiperRightCart.destroy(true, true);
                } catch (e) { console.warn(e); }
                window.swiperRightCart = null;
                swiperRightCart = null;
            }
        }

        function handleResize() {
            const nowMobile = window.innerWidth <= 768;

            if (nowMobile !== isMobile) {
                isMobile = nowMobile;
                destroySwipers();
                initSwipers();
            }
        }

        window.addEventListener("load", () => {
            initSwipers();
        });

        window.addEventListener("resize", () => {
            handleResize();
        });
        
        
    </script>

