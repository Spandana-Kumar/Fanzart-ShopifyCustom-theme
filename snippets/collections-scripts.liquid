<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/MotionPathPlugin.min.js"
        integrity="sha512-vuNgw6lF+p97XmL9lFpbQZWBXxIFnwUVt7J/uknE4NJru5GJjjhIAauXdDtNdezqOJFnit+M3AeaM+gZ93hlmg=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/Draggable.min.js"
        integrity="sha512-dgqdovLK5r/NMiV5YfWA0xC94DKGrm+6q1OZpuWHm+uBGLTck6wu58WAX9lmy8wec6cVnsgxbPJ60DtmNFnfgg=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  $(window).on("load", function () {

    gsap.registerPlugin(MotionPathPlugin);

    /* =======================
       DESKTOP
    ======================= */
    if (window.innerWidth >= 767) {
      const boxFour = gsap.utils.toArray(".box_four .box");
      const spacingFactor = 0.03;

      gsap.set(boxFour, {
        motionPath: (i) => ({
          path: "#myPath",
          align: "#myPath",
          alignOrigin: [0.5, 0.5],
          start: (i - (boxFour.length - 1) / 2) * spacingFactor - 0.25,
          end: (i - (boxFour.length - 1) / 2) * spacingFactor - 0.25,
          autoRotate: true,
        })
      });
    }

    /* =======================
       MOBILE
    ======================= */
    {% comment %} if (window.innerWidth <= 767) {
      const cardsFour = gsap.utils.toArray(".box_four .box");
      const cardCount = cardsFour.length;

      let spacingFactorMobile = 0.026;
      let pathOffset = -0.225;
      let rotationClamp = -18;

      /* ---- 4 cards override ---- */
      if (cardCount === 4) {
        pathOffset = -0.212;
        rotationClamp = -28;
      }

      gsap.set(cardsFour, {
        motionPath: (i) => ({
          path: "#myPath",
          align: "#myPath",
          alignOrigin: [0.5, 0.5],
          start: (i - (cardCount - 1) / 2) * spacingFactorMobile + pathOffset,
          end: (i - (cardCount - 1) / 2) * spacingFactorMobile + pathOffset,
          autoRotate: true,
        })
      });

      const fourFan = document.querySelector(".inner_wrap");

      // Ensure taps on cards navigate while draggable rotation stays active.
      // If rotation changes very little between pointerdown and pointerup, treat as a tap and follow the link.
      function enableTapNavigation(wrapperSelector, cardSelector) {
        const wrapper = document.querySelector(wrapperSelector);
        if (!wrapper) return;

        let pointerId = null;
        let startRotation = null;
        const ROTATION_THRESHOLD = 1.5; // degrees

        wrapper.addEventListener('pointerdown', (e) => {
          pointerId = e.pointerId;
          const style = window.getComputedStyle(wrapper);
          const transform = style.transform || style.webkitTransform;
          startRotation = 0;
          if (transform && transform !== 'none') {
            const values = transform.match(/matrix\(([^)]+)\)/);
            if (values && values[1]) {
              const parts = values[1].split(',');
              const a = parseFloat(parts[0]);
              const b = parseFloat(parts[1]);
              startRotation = Math.atan2(b, a) * (180 / Math.PI);
            }
          }
        }, { passive: true });

        wrapper.addEventListener('pointerup', (e) => {
          if (e.pointerId !== pointerId) return;
          pointerId = null;

          const style = window.getComputedStyle(wrapper);
          const transform = style.transform || style.webkitTransform;
          let endRotation = 0;
          if (transform && transform !== 'none') {
            const values = transform.match(/matrix\(([^)]+)\)/);
            if (values && values[1]) {
              const parts = values[1].split(',');
              const a = parseFloat(parts[0]);
              const b = parseFloat(parts[1]);
              endRotation = Math.atan2(b, a) * (180 / Math.PI);
            }
          }

          const diff = Math.abs(endRotation - (startRotation || 0));
          if (diff <= ROTATION_THRESHOLD) {
            const touchX = e.clientX;
            const touchY = e.clientY;
            const el = document.elementFromPoint(touchX, touchY);
            if (!el) return;
            const cardLink = el.closest ? el.closest(cardSelector) : null;
            if (cardLink) {
              const anchor = cardLink.tagName.toLowerCase() === 'a' ? cardLink : cardLink.querySelector('a');
              if (anchor && anchor.href) {
                window.location.assign(anchor.href);
              }
            }
          }
        }, { passive: true });
      }

      // enable tap navigation on this wrapper
      enableTapNavigation(".inner_wrap", ".fansCards");

      Draggable.create(fourFan, {
        type: "rotation",
        inertia: true,
        

        onDrag() {
          const clamped = gsap.utils.clamp(rotationClamp, 0, this.rotation);
          gsap.set(fourFan, { rotation: clamped });
          this.rotation = clamped;
          this.endRotation = clamped;
        },

        onThrowUpdate() {
          const clamped = gsap.utils.clamp(rotationClamp, 0, this.rotation);
          gsap.set(fourFan, { rotation: clamped });
          this.rotation = clamped;
          this.endRotation = clamped;
        },

        snap: endVal => gsap.utils.clamp(rotationClamp, 0, endVal)
      });
    } {% endcomment %}

  });
});
</script>
<script>
      document
        .querySelectorAll(".swiperCeilingMobile")
        .forEach(function (sliderEl) {
          new Swiper(sliderEl, {
            spaceBetween: 24,
            slidesPerView: 1.3,
          });
        });
    </script>

    <script>
        AOS.init({
            once: true,
        });
    </script>