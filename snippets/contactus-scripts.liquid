      <script>
        $(document).ready(function () {
            $(".tab_content").hide();
            $(".tab_content:first").show();

            $("ul.tabs li").click(function () {
                var activeTab = $(this).attr("rel");
                var tabContent = $("#" + activeTab);

                if ($(this).hasClass("active")) {
                    // If the same tab is clicked again → close it
                    $(this).removeClass("active");
                    tabContent.slideUp();
                } else {
                    // Otherwise → open it and close others
                    $("ul.tabs li").removeClass("active");
                    $(this).addClass("active");

                    $(".tab_content").slideUp();
                    tabContent.slideDown();
                }

                // Sync drawer headings
                $(".tab_drawer_heading").removeClass("d_active");
                $(".tab_drawer_heading[rel^='" + activeTab + "']").toggleClass("d_active", $(this).hasClass("active"));
            });

            // Drawer toggle (for mobile view)
            $(".tab_drawer_heading").click(function () {
                var d_activeTab = $(this).attr("rel");
                var tabContent = $("#" + d_activeTab);

                if ($(this).hasClass("d_active")) {
                    $(this).removeClass("d_active");
                    tabContent.slideUp();
                    $("ul.tabs li[rel^='" + d_activeTab + "']").removeClass("active");
                } else {
                    $(".tab_drawer_heading").removeClass("d_active");
                    $(this).addClass("d_active");

                    $(".tab_content").slideUp();
                    tabContent.slideDown();

                    $("ul.tabs li").removeClass("active");
                    $("ul.tabs li[rel^='" + d_activeTab + "']").addClass("active");
                }
            });

            $('ul.tabs li').last().addClass("tab_last");
        });
    </script>

