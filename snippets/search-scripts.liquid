<script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.6.1/nouislider.min.js"></script>

<script>
  $(document).ready(function () {
    // --- HIDE AUTO-GENERATED PRICE FACET ---
    $('.filter_outer .filter-sidebar .filter-group.accordion').each(function () {
      const headerText = $(this).find('.accordion-header').text().trim().toLowerCase();
      if (headerText === 'price') {
        $(this).hide(); // hide only the auto-generated Price facet
      }
    });

    const priceSlider = document.getElementById('price-slider');
    const minInput = $('#price-min');
    const maxInput = $('#price-max');
    const $filterContainer = $('.wishlist_product_list_middle');

    $filterContainer.hide(); // Hide filter tags initially

    // --- PRICE SLIDER INIT ---
    if (priceSlider) {
      noUiSlider.create(priceSlider, {
        start: [0, 200000],
        connect: true,
        range: { min: 0, max: 200000 },
        step: 1000,
        format: {
          to: (v) => '₹' + Math.round(v).toLocaleString('en-IN'),
          from: (v) => Number(v.replace(/[₹,]/g, '')),
        },
      });

      // Update inputs while sliding
      priceSlider.noUiSlider.on('update', function (values) {
        const cleanValues = values.map((v) => Number(v.replace(/[₹,]/g, '')));
        minInput.val('₹' + cleanValues[0].toLocaleString('en-IN'));
        maxInput.val('₹' + cleanValues[1].toLocaleString('en-IN'));
      });

      // On slider change
      priceSlider.noUiSlider.on('change', function () {
      
        updateApplyButton();
      });

      // Set initial slider and inputs from URL
      const urlParams = new URLSearchParams(window.location.search);
      const minPrice = urlParams.get('filter.v.price.gte') || 0;
      const maxPrice = urlParams.get('filter.v.price.lte') || 200000;
      priceSlider.noUiSlider.set([minPrice, maxPrice]);
    }

    // --- ACCORDION TOGGLE ---
    $('.accordion-header').on('click', function () {
        const $group = $(this).closest('.filter-group');
        const $body = $group.find('.accordion-body');
        const $sidebar = $(this).closest('.filter-sidebar');

        if ($group.hasClass('open')) {
          $group.removeClass('open');
          $body.slideUp();
        } else {
          $group.addClass('open');
          $body.slideDown(300, function () {
            
            if ($sidebar.length) {
              $sidebar.animate(
                { scrollTop: $group.position().top },
                300
              );
            }
          });
        }
      });


    // --- CHECKBOX / RADIO CHANGES ---
    $(".accordion-body input[type='checkbox'], .accordion-body input[type='radio']").on('change', function () {
     
      updateApplyButton();
    });

    // --- SET INPUTS FROM URL (on page load) ---
    function setInputsFromUrl() {
      const params = new URLSearchParams(window.location.search);

      // For each input with data-filter, check if URL has values for that facet
      $('.accordion-body input[data-filter]').each(function () {
        const facet = $(this).data('filter');
        const val = $(this).val();
        if (!facet) return;

        const values = params.getAll(facet);
        if (values && values.length) {
          // For checkboxes: may be multiple values
          if ($(this).is(':checkbox')) {
            $(this).prop('checked', values.includes(val));
          } else if ($(this).is(':radio')) {
            $(this).prop('checked', values.includes(val));
          }
        } else {
          // If no param for this facet, ensure unchecked
          $(this).prop('checked', false);
        }
      });
    }

    // --- UPDATE APPLY BUTTON ---
    function updateApplyButton() {
      let hasFilters = $('.accordion-body input:checked').length > 0;
      if (priceSlider) {
        const [min, max] = priceSlider.noUiSlider.get().map((v) => Number(v.replace(/[₹,]/g, '')));
        if (min > 0 || max < 200000) hasFilters = true;
      }
      $('.filter-action').toggleClass('show', hasFilters);
    }

    // --- UPDATE SELECTED FILTER TAGS ---
    function updateSelectedFilters() {
      const $filterAdded = $filterContainer.find('.filterAdded');
      $filterAdded.empty();

      let hasAnyFilter = false; // track if any filter is selected
      let inputUidCounter = 0;

      // Checked filters
      $('.accordion-body input[type="checkbox"]:checked, .accordion-body input[type="radio"]:checked').each(
        function () {
          hasAnyFilter = true;
          // give this input a stable uid so tags can reference it reliably
          const inputUid = 'filter-uid-' + inputUidCounter++;
          $(this).attr('data-input-uid', inputUid);
          const filterTitle = $(this)
            .closest('.filter-group')
            .find('.accordion-header')
            .clone()
            .children()
            .remove()
            .end()
            .text()
            .trim();
          const filterValue = $(this).parent().clone().children('input').remove().end().text().trim();
          const filterId = $(this).attr('id');
          const facetName = $(this).data('filter');
          const facetValue = $(this).val();

          // Include data attributes so remove handler can target inputs even if id is missing or contains special chars
          const filterTag = $(`
                <span data-filter-id="${filterId || ''}" data-facet="${facetName || ''}" data-value="${
            facetValue || ''
          }" data-input-uid="${inputUid}">
                    <a href="javascript:;" class="removeIcon">
                        <img src="{{ 'img_icons_x.svg' | asset_url }}" alt="Remove">
                    </a>
                    <em class="filterTitle">${filterTitle}: <strong>${filterValue}</strong></em>
                </span>
            `);
          $filterAdded.append(filterTag);
        }
      );

      // Price tag
      if (priceSlider) {
        const [priceMin, priceMax] = priceSlider.noUiSlider.get().map((v) => Number(v.replace(/[₹,]/g, '')));
        if (priceMin > 0 || priceMax < 200000) {
          hasAnyFilter = true;
          const priceTag = $(`
                    <span data-filter-id="price-range" data-filter-type="price">
                        <a href="javascript:;" class="removeIcon">
                            <img src="{{ 'img_icons_x.svg' | asset_url }}" alt="Remove">
                        </a>
                        <em class="filterTitle">Price: <strong>₹${priceMin.toLocaleString(
                          'en-IN'
                        )} – ₹${priceMax.toLocaleString('en-IN')}</strong></em>
                    </span>
                `);
          $filterAdded.append(priceTag);
        }
      }

      // Show or hide the wishlist_product_list_middle container
      if (hasAnyFilter) {
        $filterContainer.addClass('show').show();
      } else {
        $filterContainer.removeClass('show').hide();
      }

      updateAccordionCounts();
      updateApplyButton();
    }

    // --- UPDATE COUNTS IN HEADERS ---
    function updateAccordionCounts() {
      $('.filter-group').each(function () {
        const count = $(this).find('input:checked').length;
        const $countEl = $(this).find('.selected-count');
        $countEl.text(count > 0 ? count : '');
        $countEl.toggleClass('show', count > 0);
      });
    }

    // --- REMOVE TAG ---
    $(document).on('click', '.removeIcon', function (e) {
      e.preventDefault();
      const $span = $(this).closest('span');
      const filterId = $span.data('filter-id');

      // Prefer lookup by stable uid set on updateSelectedFilters
      let removed = false;
      const inputUid = $span.data('input-uid');
      if (inputUid) {
        const $byUid = $(`.accordion-body input[data-input-uid="${inputUid}"]`);
        if ($byUid.length) {
          $byUid.prop('checked', false).trigger('change');
          removed = true;
        }
      }

      // Fallback: try by id
      if (!removed && filterId && filterId !== 'price-range') {
        const inputEl = document.getElementById(filterId);
        if (inputEl) {
          $(inputEl).prop('checked', false).trigger('change');
          removed = true;
        }
      }

      // Final fallback: facet+value selector
      if (!removed) {
        const facet = $span.data('facet');
        const value = $span.data('value');
        if (facet && typeof value !== 'undefined') {
          const $candidates = $('.accordion-body input[data-filter]');
          const $target = $candidates.filter(function () {
            return $(this).data('filter') == facet && String($(this).val()) == String(value);
          });
          if ($target.length) {
            $target.prop('checked', false).trigger('change');
            removed = true;
          }
        }
      }

      // If tag represents the price range, reset slider
      if ($span.data('filter-id') === 'price-range' || $span.data('filter-type') === 'price') {
        if (priceSlider) priceSlider.noUiSlider.set([0, 200000]);
      }

      // Rebuild URL from current checked inputs and price and navigate
      applyFiltersToUrl();
    });

    // --- CLEAR ALL ---
    $(document).on('click', '.clearAllBtn', function () {
      // Clear UI selections
      $('.accordion-body input').prop('checked', false);
      if (priceSlider) priceSlider.noUiSlider.set([0, 200000]);
      updateSelectedFilters();

      // If on search page, redirect to previous search results (preserve query)
      var path = window.location.pathname.split('?')[0];
      if (path.indexOf('/search') !== -1) {
        var urlParams = new URLSearchParams(window.location.search);
        var searchTerm = urlParams.get('q') || urlParams.get('query') || '';
        // If search term exists, redirect to search with query
        if (searchTerm) {
          window.location.href = '/search?q=' + encodeURIComponent(searchTerm);
        } else {
          window.location.href = '/search';
        }
      } else {
        // For collections, keep default behavior
        const collectionUrl = path;
        window.location.href = collectionUrl;
      }
    });

    // --- OPEN/CLOSE FILTER PANEL ---
           $(".filterLink").on("click", function (e) {
                e.stopPropagation();
                $(".filter_outer").addClass("show");
                $("body").addClass("noScroll");
            });
            // Close filter panel
            $(".close-filter").on("click", function (e) {
                e.stopPropagation();
                $(".filter_outer").removeClass("show");
                $("body").removeClass("noScroll");
            });
            $(".filterText").on("click", function (e) {
                e.stopPropagation();
                $(".filter_outer").removeClass("show");
                $("body").removeClass("noScroll");
            });
            // Close filter when clicking outside
            $(document).on("click", function (e) {
                if (
                    $(".filter_outer").hasClass("show") &&
                    !$(e.target).closest(".filter_outer").length
                ) {
                    $(".filter_outer").removeClass("show");
                    $("body").removeClass("noScroll");
                }
            });

    // --- APPLY BUTTON ---
    $('.filter-apply-btn').on('click', function () {
      updateSelectedFilters(); // Show filter tags only when Apply is clicked
      $('.filter_outer').removeClass('show'); // Hide filter panel
      $('body').removeClass('noScroll');
      $('.wishlist_product_list_middle').addClass('show'); // Show product section
      applyFiltersToUrl();
    });
    // --- APPLY / BUILD URL FROM CURRENT SELECTIONS ---
    function applyFiltersToUrl() {
      const params = new URLSearchParams();

      // Checked filters
      $('.accordion-body input[type="checkbox"]:checked, .accordion-body input[type="radio"]:checked').each(
        function () {
          const facet = $(this).data('filter');
          const value = $(this).val();
          if (facet && value) params.append(facet, value);
        }
      );

      // Price
      if (priceSlider) {
        const [min, max] = priceSlider.noUiSlider.get().map((v) => Number(v.replace(/[₹,]/g, '')));
        if (!isNaN(min) && min > 0) params.set('filter.v.price.gte', min);
        if (!isNaN(max) && max < 200000) params.set('filter.v.price.lte', max);
      }

      // Preserve existing search query (q) and sort_by if present (so filters work on /search)
      const currentParams = new URLSearchParams(window.location.search);
      const preservedQ = currentParams.get('q');
      const preservedSort = currentParams.get('sort_by');

      // Append preserved params to our new params only if they exist and aren't overwritten
      if (preservedQ && !params.has('q')) params.set('q', preservedQ);
      if (preservedSort && !params.has('sort_by')) params.set('sort_by', preservedSort);

      const collectionUrl = window.location.pathname.split('?')[0];
      const queryString = params.toString();
      const finalUrl = queryString ? `${collectionUrl}?${queryString}` : collectionUrl;

      // Navigate to the new URL to update products
      window.location.href = finalUrl;
    }

    // --- INITIAL SETUP ---
    // Read URL and set inputs first so UI reflects any pre-applied filters
    setInputsFromUrl();
    updateAccordionCounts();
    updateApplyButton();
    updateSelectedFilters();
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let tooltipTimeout;

    //Check login status
    function isLoggedIn() {
      try {
        const ts = localStorage.getItem('sml_login_time');
        if (!ts) return false;
        return Date.now() - Number(ts) < 24 * 60 * 60 * 1000; // 24h validity
      } catch (e) {
        return false;
      }
    }

    // Toggle wishlist dropdowns
    function toggleWishlistDropdowns() {
      document.querySelectorAll('.wishlist-dropdown').forEach(function (dropdown) {
        dropdown.style.display = isLoggedIn() ? '' : 'none';
      });
    }
    toggleWishlistDropdowns();

    // Save product to localStorage
    function addProductToFolder(name, product) {
      let folders = JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
      let folder = folders.find((f) => f.name === name);
      if (!folder) {
        folder = { id: Date.now(), name: name, products: [] };
        folders.push(folder);
      }
      folder.products.push(product);
      localStorage.setItem('wishlist_folders', JSON.stringify(folders));
      localStorage.removeItem('wishlist_pending_product');
    }

    // Remove product from folder. If variantId provided, remove only that variant entry.
    function removeProductFromFolder(productId, folderName, variantId) {
      let folders = JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
      let folder = folders.find((f) => f.name === folderName);
      if (folder) {
        if (variantId) {
          folder.products = folder.products.filter((p) => !(String(p.id) === String(productId) && String(p.variantId) === String(variantId)));
        } else {
          folder.products = folder.products.filter((p) => String(p.id) !== String(productId));
        }
        localStorage.setItem('wishlist_folders', JSON.stringify(folders));
      }
    }

    // Get folder containing product. If variantId provided, search for exact variant match.
    function getProductFolder(productId, variantId) {
      let folders = JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
      for (let folder of folders) {
        if (variantId) {
          if (folder.products.some((p) => String(p.id) === String(productId) && String(p.variantId) === String(variantId))) {
            return folder.name;
          }
        } else {
          if (folder.products.some((p) => String(p.id) === String(productId))) {
            return folder.name;
          }
        }
      }
      return null;
    }

    // Toast message
    function showToast(msg, undoCallback = null) {
      const tooltip = document.querySelector('.tooltip-msg');
      if (!tooltip) return;

      tooltip.querySelector('.tooltip-text').textContent = msg;

      const undoBtn = tooltip.querySelector('.undoBtn');
      if (undoCallback) {
        undoBtn.style.display = 'inline-block';
        undoBtn.onclick = function () {
          undoCallback();
          tooltip.classList.remove('show');
          tooltip.style.display = 'none';
        };
      } else {
        undoBtn.style.display = 'none';
      }

      tooltip.style.display = 'block';
      tooltip.classList.add('show');

      clearTimeout(tooltipTimeout);
      tooltipTimeout = setTimeout(() => {
        tooltip.classList.remove('show');
        tooltip.style.display = 'none';
      }, 2500);
    }

 // Render folders inside dropdown
    function renderProjects(dropdown) {
      let folders = JSON.parse(localStorage.getItem('wishlist_folders') || '[]');

      // ensure we can find the static inner container (where .list and .list-create live)
      const inner = dropdown.querySelector('.wishlist-inner') || dropdown;
      let list = inner.querySelector('.list');

      // If no folders: remove the .list element so only the static create area remains
      if (!folders || folders.length === 0) {
        if (list) list.remove();
        return;
      }

      // If folders exist but .list was removed previously, recreate it before the create block
      if (!list) {
        list = document.createElement('div');
        list.className = 'list';
        const createBlock = inner.querySelector('.list-create');
        if (createBlock) inner.insertBefore(list, createBlock);
        else inner.appendChild(list);
      }

      // populate list
      list.innerHTML = '';
      folders.forEach((folder) => {
        const option = document.createElement('div');
        option.className = 'option';
        option.textContent = folder.name;
        option.style.cursor = 'pointer';
        list.appendChild(option);
      });
    }

    // Update icon state based on wishlist status
    function updateIconState(card) {
      const productId = card.dataset.productId;
      const likeBtn = card.querySelector('.likes.actionBtn');
      const variantId = likeBtn ? likeBtn.getAttribute('data-variant-id') || null : null;
      const folderName = getProductFolder(productId, variantId);
      likeBtn.classList.toggle('active', !!folderName);
    }

    // Handle wishlist button click
    document.querySelectorAll('.listing_card').forEach((card) => {
      const likeBtn = card.querySelector('.likes.actionBtn');
      if (!likeBtn) return;

      // Update initial icon state
      updateIconState(card);

      likeBtn.addEventListener('click', function (ev) {
        ev.preventDefault();
        ev.stopPropagation();

        const productId = card.dataset.productId;
        const variantId = likeBtn.getAttribute('data-variant-id') || null;
        const folderName = getProductFolder(productId, variantId);

        // If the exact variant is already in wishlist (icon is dark), remove that variant
        if (folderName) {
          removeProductFromFolder(productId, folderName, variantId);
          likeBtn.classList.remove('active');

          showToast(`Product successfully removed from '${folderName}' in your Wishlist`, function undoAction() {
            // Re-add product-variant on UNDO
            let pending = {
              id: productId,
              handle: card.dataset.productHandle,
              title: card.dataset.productTitle,
              image: (function () {
                const firstImage = card.querySelector('.magicImg .defaultImg');
                if (firstImage) return (firstImage.dataset && firstImage.dataset.src) || firstImage.getAttribute('src');
                const mainImage = card.querySelector('.mainImg img');
                return mainImage ? mainImage.getAttribute('src') : '';
              })(),
              price: card.querySelector('.priceValue')?.textContent.trim() || '',
              variantId: variantId,
              options: {},
            };
            addProductToFolder(folderName, pending);
            updateIconState(card);
          });

          return;
        }

        // Otherwise, add to wishlist
        const pending = {
          id: card.dataset.productId || null,
          handle: card.dataset.productHandle || null,
          title:
            card.dataset.productTitle ||
            (card.querySelector('.defaultDetails h4')
              ? card.querySelector('.defaultDetails h4').textContent.trim()
              : 'Product'),
          image: (function () {
            const firstImage = card.querySelector('.magicImg .defaultImg');
            if (firstImage) return (firstImage.dataset && firstImage.dataset.src) || firstImage.getAttribute('src');
            const mainImage = card.querySelector('.mainImg img');
            return mainImage ? mainImage.getAttribute('src') : '';
          })(),
          price: card.querySelector('.priceValue') ? card.querySelector('.priceValue').textContent.trim() : '',
          outOfStock: card.classList.contains('outOfStock'),
          variantId: likeBtn.getAttribute('data-variant-id') || null,
          options: {
            color: likeBtn.getAttribute('data-option-color') || '',
            sweep: likeBtn.getAttribute('data-option-sweep') || '',
            watt: likeBtn.getAttribute('data-option-watt') || '',
            material: likeBtn.getAttribute('data-option-material') || '',
            light: likeBtn.getAttribute('data-option-light') || '',
            mount: likeBtn.getAttribute('data-option-mount') || '',
            addon: likeBtn.getAttribute('data-option-addon') || '',
          },
        };

        localStorage.setItem('wishlist_pending_product', JSON.stringify(pending));

        if (!isLoggedIn()) {
          window.location.href = '/pages/wishlist';
          return;
        }

        // Show dropdown
        const dropdown = card.querySelector('.wishlist-dropdown');
        if (dropdown) {
          renderProjects(dropdown);
          dropdown.classList.toggle('show');
          document.querySelectorAll('.wishlist-dropdown').forEach((dd) => {
            if (dd !== dropdown) dd.classList.remove('show');
          });
        }
      });
    });

    // Select existing project
    document.addEventListener('click', function (e) {
      if (e.target.classList.contains('option')) {
        e.preventDefault();
        e.stopPropagation();

        const projectName = e.target.textContent.trim();
        const pending = JSON.parse(localStorage.getItem('wishlist_pending_product') || 'null');
        if (!pending) return;

        addProductToFolder(projectName, pending);

        // Update icon state for the card
        const card = e.target.closest('.listing_card') || document.querySelector(`[data-product-id="${pending.id}"]`);
        if (card) {
          updateIconState(card);
        }

        showToast(`Product successfully added to '${projectName}'`, function undoAction() {
          removeProductFromFolder(pending.id, projectName);
          updateIconState(card);
        });

        const dropdown = e.target.closest('.wishlist-dropdown');
        if (dropdown) dropdown.classList.remove('show');
      }

      // Open create project popup
      if (e.target.classList.contains('create-btn')) {
        e.stopPropagation();
        document.querySelector('.popup-overlay')?.classList.add('showPopup');
        document.body.classList.add('overflow-hidden');
        const input = document.getElementById('new-wishlist-name');
        if (input) {
          input.value = '';
          input.classList.remove('error');
        }
        document.querySelector('.wishlist-error-msg')?.classList.add('hidden');

        // disable create button initially
        document.getElementById('add-wishlist')?.setAttribute('disabled', 'true');
      }
    });

    // Outside click closes dropdowns
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.wishlist-dropdown') && !e.target.classList.contains('actionBtn')) {
        document.querySelectorAll('.wishlist-dropdown').forEach((dd) => dd.classList.remove('show'));
      }
    });

    // Close popup
    document.getElementById('closePopup-wishlist')?.addEventListener('click', function () {
      document.querySelector('.popup-overlay')?.classList.remove('showPopup');
      document.body.classList.remove('overflow-hidden');
    });

    // Create new project
    document.getElementById('add-wishlist')?.addEventListener('click', function () {
      const input = document.getElementById('new-wishlist-name');
      if (!input || !input.value.trim()) {
        input?.classList.add('error');
        document.querySelector('.wishlist-error-msg')?.classList.remove('hidden');
        return;
      }

      const newName = input.value.trim();
      let pendingProduct = JSON.parse(localStorage.getItem('wishlist_pending_product') || 'null');

      let folders = JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
      let exists = folders.find((f) => f.name.toLowerCase() === newName.toLowerCase());

      if (exists) {
        input.classList.add('error');
        const errorMsg = document.querySelector('.wishlist-error-msg');
        if (errorMsg) {
          errorMsg.textContent = 'Project name already exists!';
          errorMsg.classList.remove('hidden');
        }
        return; // stop creating duplicate
      }

      const newFolder = { id: Date.now(), name: newName, products: pendingProduct ? [pendingProduct] : [] };
      folders.push(newFolder);
      localStorage.setItem('wishlist_folders', JSON.stringify(folders));
      localStorage.removeItem('wishlist_pending_product');

      // Update icon state for the card
      if (pendingProduct) {
        const card = document.querySelector(`[data-product-id="${pendingProduct.id}"]`);
        if (card) {
          updateIconState(card);
        }
      }

      // Close popup
      input.value = '';
      document.querySelector('.popup-overlay')?.classList.remove('showPopup');
      document.body.classList.remove('overflow-hidden');

      showToast(`Product successfully added to '${newName}'`);
    });

    // Validate input while typing
    document.getElementById('new-wishlist-name')?.addEventListener('input', function () {
      const createBtn = document.getElementById('add-wishlist');
      const errorMsg = document.querySelector('.wishlist-error-msg');
      let folders = JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
      let exists = folders.some((f) => f.name.toLowerCase() === this.value.trim().toLowerCase());

      if (this.value.trim() === '') {
        this.classList.add('error');
        errorMsg.textContent = 'Please enter a project name.';
        errorMsg.classList.remove('hidden');
        createBtn?.setAttribute('disabled', 'true');
      } else if (exists) {
        this.classList.add('error');
        errorMsg.textContent = 'Project name already exists!';
        errorMsg.classList.remove('hidden');
        createBtn?.setAttribute('disabled', 'true');
      } else {
        this.classList.remove('error');
        errorMsg.classList.add('hidden');
        createBtn?.removeAttribute('disabled');
      }
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dropdown = document.querySelector('.customDropdown');
    const selected = dropdown.querySelector('.selected');
    const options = dropdown.querySelectorAll('.options li');

    // Get current URL and remove page parameter to reset to page 1
    function getCollectionUrl(sortValue) {
      const url = new URL(window.location.href);
      // Remove 'page' parameter to reset pagination
      url.searchParams.delete('page');
      // Set the sort parameter
      if (sortValue) {
        url.searchParams.set('sort_by', sortValue);
      } else {
        url.searchParams.delete('sort_by');
      }
      return url.toString();
    }

    // Initialization: respect server-side active option if present.
    // If an option already has the 'active' class (rendered server-side via collection.sort_by),
    // display it. Otherwise show a non-selectable placeholder 'Sort by'.
    const activeOption = Array.from(options).find((opt) => opt.classList.contains('active'));
    if (activeOption) {
      selected.textContent = activeOption.textContent.trim();
    } else {
      selected.textContent = 'Sort by';
    }

    // Toggle dropdown
    selected.addEventListener('click', () => {
      dropdown.classList.toggle('open');
      selected.classList.toggle('open');
    });

    // Select option
    options.forEach((option) => {
      option.addEventListener('click', () => {
        options.forEach((opt) => opt.classList.remove('active'));
        option.classList.add('active');
        selected.textContent = option.textContent;
        dropdown.classList.remove('open');
        selected.classList.remove('open');

        // Navigate to collection URL with sort parameter (applies to all pages)
        const sortValue = option.dataset.value;
        window.location.href = getCollectionUrl(sortValue);
      });
    });

    // Close dropdown if clicking outside
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target)) {
        dropdown.classList.remove('open');
        selected.classList.remove('open');
      }
    });
  });
</script>

<script>
  // Make listing page wishlist icons variant-aware: update like button variantId
  document.addEventListener('DOMContentLoaded', function () {
    function getFolders() {
      return JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
    }

    function isSaved(productId, variantId) {
      const folders = getFolders();
      for (const f of folders) {
        for (const p of f.products || []) {
          if (String(p.id) === String(productId)) {
            if (variantId) {
              if (String(p.variantId) === String(variantId)) return true;
            } else return true;
          }
        }
      }
      return false;
    }

    function updateCardIcon(btn) {
      if (!btn) return;
      const pid = btn.getAttribute('data-id') || btn.dataset.id || '';
      const vid = btn.getAttribute('data-variant-id') || btn.dataset.variantId || null;
      const active = isSaved(pid, vid);
      btn.classList.toggle('active', !!active);
    }

    function updateAllCards() {
      document.querySelectorAll('.likes.actionBtn').forEach((b) => updateCardIcon(b));
    }

    // Wire per-card variant selection -> update like button variantId
    document.querySelectorAll('.listing_card').forEach((card) => {
      const variantsJsonEl = card.querySelector('.product-variants-json');
      let variants = [];
      try {
        variants = variantsJsonEl ? JSON.parse(variantsJsonEl.textContent || '[]') : [];
      } catch (e) {
        variants = [];
      }

      const likeBtn = card.querySelector('.likes.actionBtn');

      function setVariantFromSelection() {
        try {
          const activeColorEl = card.querySelector('.colorFlex .colorImg.active');
          const color = activeColorEl ? (activeColorEl.dataset.color || activeColorEl.textContent || '').toString().trim() : '';
          const activeSizeEl = card.querySelector('.size li.active');
          const size = activeSizeEl ? (activeSizeEl.dataset.rawSize || activeSizeEl.textContent || '').toString().trim() : '';

          let match = variants.find((v) => {
            const vColor = (v.option1 || '').toString().trim().toLowerCase();
            const vSize = (v.option2 || '').toString().trim().toLowerCase();
            if (color && vColor !== color.toLowerCase()) return false;
            if (size && vSize !== size.toLowerCase()) return false;
            return true;
          });
          if (!match && color) {
            match = variants.find((v) => (v.option1 || '').toString().trim().toLowerCase() === color.toLowerCase());
          }
          if (!match && variants.length) match = variants[0];

          if (match && likeBtn) {
            likeBtn.setAttribute('data-variant-id', match.id);
          }
          if (likeBtn) updateCardIcon(likeBtn);
        } catch (err) {
          /* ignore */
        }
      }

      // Initial set
      setVariantFromSelection();

      // When user changes color or size, update the like button's variant id
      card.querySelectorAll('.colorFlex .colorImg').forEach((el) => {
        el.addEventListener('click', function () {
          // allow other handlers to toggle active class first
          setTimeout(setVariantFromSelection, 0);
        });
      });
      card.querySelectorAll('.size li').forEach((el) => {
        el.addEventListener('click', function () {
          setTimeout(setVariantFromSelection, 0);
        });
      });
    });

    // Update icons initially and when storage/custom events change
    updateAllCards();
    window.addEventListener('storage', function (e) {
      if (e.key === 'wishlist_folders') updateAllCards();
    });
    window.addEventListener('wishlist:changed', function () {
      updateAllCards();
    });
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.innerWidth >= 767) {
      const cards = document.querySelectorAll('.listing_card');
      const outOfStock = document.querySelectorAll('.outOfStock');
      cards.forEach((card) => {
        const lifestyleImg = card.querySelector('.lifestyleImg');
        const magicImgs = card.querySelectorAll('.magicImg img');
        const colorOptions = card.querySelectorAll('.colorFlex .colorImg');
        const defaultImg = card.querySelector('.magicImg .defaultImg');
        const productDetails = card.querySelector('.product_details');
        const hiddenDetails = card.querySelector('.hiddenDetails');
        const colorTitleFlex = card.querySelector('.colorTitleFlex');
        let selectedSrc =
          defaultImg.dataset && defaultImg.dataset.src ? defaultImg.dataset.src : defaultImg.getAttribute('src'); // Default selected
        const originalSrc = selectedSrc; // keep original for restore on mouseleave
        // Helper: Hide all magic images
        function hideAllMagicImages() {
          magicImgs.forEach((img) => {
            img.classList.remove('show');
            img.classList.add('hide');
          });
        }
        // Show selected image in magicImg
        // showSelectedImage(optionalSrc) - if optionalSrc provided, show that src without modifying selectedSrc
        function showSelectedImage(optionalSrc) {
          const srcToShow = optionalSrc || selectedSrc;
          hideAllMagicImages();
          lifestyleImg.classList.remove('show');
          lifestyleImg.classList.add('hide');
          const targetImg = Array.from(magicImgs).find(
            (img) => (img.dataset && img.dataset.src ? img.dataset.src : img.getAttribute('src')) === srcToShow
          );
          if (targetImg) {
            targetImg.classList.remove('hide');
            targetImg.classList.add('show');
          } else if (srcToShow) {
            // fallback: set the defaultImg src to the srcToShow and show it
            try {
              defaultImg.setAttribute('src', srcToShow);
              if (defaultImg.dataset) defaultImg.dataset.src = srcToShow;
              defaultImg.classList.remove('hide');
              defaultImg.classList.add('show');
            } catch (e) {
              // ignore
            }
          }
        }
        // Initial state
        showSelectedImage();
        // Hover on card: show hover image (second magic image) if present, otherwise show lifestyle image
        card.addEventListener('mouseenter', function () {
          productDetails.classList.add('floating');
          hiddenDetails.classList.add('expend');
          colorTitleFlex.classList.add('hidden');
          // try to find hover image inside magicImgs (prefer element with class 'colorImg')
          const hoverImg = card.querySelector('.magicImg .colorImg');
          if (hoverImg) {
            hideAllMagicImages();
            // hide lifestyle
            lifestyleImg.classList.remove('show');
            lifestyleImg.classList.add('hide');
            // show hover
            hoverImg.classList.remove('hide');
            hoverImg.classList.add('show');
          } else {
            // fallback: show lifestyle image
            lifestyleImg.classList.remove('hide');
            lifestyleImg.classList.add('show');
            hideAllMagicImages();
          }
        });
        // On leave: restore the original default image (hover is temporary)
        card.addEventListener('mouseleave', function () {
          // Restore image
          showSelectedImage(originalSrc);
          // Set first color as active (default) when coming back from hover
          const firstColor = colorOptions && colorOptions.length ? colorOptions[0] : null;
          if (firstColor) {
            // reset active classes
            colorOptions.forEach((opt) => opt.classList.remove('active'));
            firstColor.classList.add('active');
            // update selectedSrc to first color's target (but we won't show it, image remains original)
            const swatchImg = firstColor.querySelector('img');
            let firstTarget = '';
            if (swatchImg && swatchImg.dataset && swatchImg.dataset.targetSrc)
              firstTarget = swatchImg.dataset.targetSrc;
            else if (firstColor.dataset && firstColor.dataset.targetSrc) firstTarget = firstColor.dataset.targetSrc;
            else if (swatchImg) firstTarget = swatchImg.getAttribute('src');
            if (firstTarget) selectedSrc = firstTarget;
            // update sizes for the first color
            try {
              const variantsJsonEl = card.querySelector('.product-variants-json');
              if (variantsJsonEl) {
                const variants = JSON.parse(variantsJsonEl.textContent || '[]');
                const selectedColor = firstColor.dataset.color || (firstColor.textContent || '').trim();
                const sizes = [];
                variants.forEach((v) => {
                  const vColor = (v.option1 || '').toString();
                  const vSize = (v.option2 || '').toString();
                  if (vColor.toLowerCase() === selectedColor.toLowerCase()) {
                    if (vSize && sizes.indexOf(vSize) === -1) sizes.push(vSize);
                  }
                });
                const sizeUl = card.querySelector('.size');
                if (sizeUl) {
                  sizeUl.innerHTML = '';
                  if (sizes.length === 0) {
                    const li = document.createElement('li');
                    li.classList.add('active');
                    li.textContent = '-';
                    sizeUl.appendChild(li);
                  } else {
                    sizes.forEach((s, idx) => {
                      const li = document.createElement('li');
                      if (idx === 0) li.classList.add('active');
                      // keep raw size for logic and show trimmed version to user
                      li.dataset.rawSize = s;
                      li.textContent = (function (raw) {
                        try {
                          // Extract text inside parentheses
                          const m = raw.match(/\(([^)]+)\)/);
                          if (m && m[1]) {
                            // Remove both single and double quotes and trim
                            return m[1].replace(/['"]/g, '').trim();
                          }
                          const parts = raw.split('-');
                          return parts.length > 1
                            ? parts[parts.length - 1].replace(/['"]/g, '').trim()
                            : raw.replace(/['"]/g, '').trim();
                        } catch (e) {
                          return raw.replace(/['"]/g, '').trim();
                        }
                      })(s);
                      sizeUl.appendChild(li);
                    });
                    
                  }
                  // After updating sizes, also update the displayed price to match the restored first color (and first size if present)
                  try {
                    const activeLi = sizeUl.querySelector('li.active');
                    const selectedSizeRaw =
                      activeLi && activeLi.dataset && activeLi.dataset.rawSize
                        ? activeLi.dataset.rawSize
                        : activeLi
                        ? activeLi.textContent
                        : null;
                    updateCardPrice(card, variants, { color: selectedColor, size: selectedSizeRaw });

                    // Update like button variant id and icon state to match restored first color/size
                    try {
                      const likeBtnForCard = card.querySelector('.likes.actionBtn');
                      if (likeBtnForCard) {
                        const lc = (selectedColor || '').toString().trim().toLowerCase();
                        const ls = selectedSizeRaw ? selectedSizeRaw.toString().trim().toLowerCase() : '';
                        let matched = null;
                        for (let v of variants) {
                          const vColor = (v.option1 || '').toString().trim().toLowerCase();
                          const vSize = (v.option2 || '').toString().trim().toLowerCase();
                          if (lc && ls) {
                            if (vColor === lc && vSize === ls) { matched = v; break; }
                          } else if (lc) {
                            if (vColor === lc) { matched = v; break; }
                          }
                        }
                        if (!matched && variants.length) matched = variants[0];
                        if (matched && (matched.id || matched.id === 0)) {
                          likeBtnForCard.setAttribute('data-variant-id', matched.id);

                          // determine if this variant is saved in any wishlist folder
                          let saved = false;
                          try {
                            const folders = JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
                            for (const f of folders) {
                              if ((f.products || []).some((p) => String(p.id) === String(card.dataset.productId) && String(p.variantId) === String(matched.id))) {
                                saved = true;
                                break;
                              }
                            }
                          } catch (e) {
                            saved = false;
                          }
                          likeBtnForCard.classList.toggle('active', !!saved);
                        }
                      }
                    } catch (e) {
                      // ignore
                    }
                  } catch (err) {
                    // ignore price update errors
                  }
                }
              }
            } catch (e) {
              // ignore
            }
          }
          productDetails.classList.remove('floating');
          colorTitleFlex.classList.remove('hidden');
          hiddenDetails.classList.remove('expend');
          
        });
        // Click on color options
        colorOptions.forEach((option) => {
          option.addEventListener('click', function (evt) {
            // prevent any anchor or parent handlers from navigating/refreshing
            evt.preventDefault();
            evt.stopPropagation();
            // Remove active class from all and set on clicked
            colorOptions.forEach((opt) => opt.classList.remove('active'));
            this.classList.add('active');
            // Get the target image source (prefer data-target-src on swatch img)
            const swatchImg = this.querySelector('img');
            let targetSrc = '';
            if (swatchImg && swatchImg.dataset && swatchImg.dataset.targetSrc) {
              targetSrc = swatchImg.dataset.targetSrc;
            } else {
              // fallback: if swatch contains data-target-src attribute itself (e.g., swatchFallback)
              if (this.dataset && this.dataset.targetSrc) targetSrc = this.dataset.targetSrc;
              else if (swatchImg) targetSrc = swatchImg.getAttribute('src');
            }
            if (targetSrc) {
              selectedSrc = targetSrc;
            }
            showSelectedImage();
            // Update size list: find variants JSON and filter by selected color
            try {
              const variantsJsonEl = card.querySelector('.product-variants-json');
              if (variantsJsonEl) {
                const variants = JSON.parse(variantsJsonEl.textContent || '[]');
                const selectedColor = option.dataset.color || (option.textContent || '').trim();
                const sizes = [];
                variants.forEach((v) => {
                  const vColor = (v.option1 || '').toString();
                  const vSize = (v.option2 || '').toString();
                  if (vColor.toLowerCase() === selectedColor.toLowerCase()) {
                    if (vSize && sizes.indexOf(vSize) === -1) sizes.push(vSize);
                  }
                });
                // Update the size list markup (ul.size)
                const sizeUl = card.querySelector('.size');
                if (sizeUl) {
                  sizeUl.innerHTML = '';
                  if (sizes.length === 0) {
                    const li = document.createElement('li');
                    li.classList.add('active');
                    li.textContent = '-';
                    sizeUl.appendChild(li);
                  } else {
                    sizes.forEach((s, idx) => {
                      const li = document.createElement('li');
                      if (idx === 0) li.classList.add('active');
                      li.dataset.rawSize = s;
                      li.textContent = (function (raw) {
                        try {
                          const m = raw.match(/\(([^)]+)\)/);
                          if (m && m[1]) return m[1].trim();
                          const parts = raw.split('-');
                          return parts.length > 1 ? parts[parts.length - 1].trim() : raw.trim();
                        } catch (e) {
                          return raw;
                        }
                      })(s);
                      sizeUl.appendChild(li);
                    });
                  }
                }
                // Update price when color is selected
                updateCardPrice(card, variants, { color: selectedColor });
                
              }
            } catch (e) {
              // ignore JSON parse errors
            }
          });
        });

        // Listen for size (sweep) clicks to update price
        const sizeContainer = card.querySelector('.size');
        if (sizeContainer) {
          sizeContainer.addEventListener('click', function (ev) {
            const targetLi = ev.target.closest('li');
            if (!targetLi) return;
            // set active
            Array.from(sizeContainer.querySelectorAll('li')).forEach((li) => li.classList.remove('active'));
            targetLi.classList.add('active');
            try {
              const variantsJsonEl = card.querySelector('.product-variants-json');
              if (variantsJsonEl) {
                const variants = JSON.parse(variantsJsonEl.textContent || '[]');
                const activeColorEl = card.querySelector('.colorFlex .colorImg.active');
                const selectedColor = activeColorEl
                  ? activeColorEl.dataset.color || activeColorEl.textContent.trim()
                  : null;
                // prefer rawSize data when present (used for matching variants), fallback to visible text
                const selectedSize =
                  targetLi.dataset && targetLi.dataset.rawSize
                    ? targetLi.dataset.rawSize.trim()
                    : targetLi.textContent.trim();
                updateCardPrice(card, variants, { color: selectedColor, size: selectedSize });
              }
            } catch (e) {
              /* ignore */
            }
          });
        }
        {% comment %} outOfStock.forEach((outOfStockCard) => {
          outOfStockCard.addEventListener('mouseenter', function () {
            showSelectedImage();
            productDetails.classList.remove('floating');
            colorTitleFlex.classList.remove('hidden');
            hiddenDetails.classList.remove('expend');
          });
        }); {% endcomment %}
      });
    }
  });
</script>
<script>
  // Toggle 'indicatorGreen' on filter link when any filter is active
  (function () {
    function filtersAreActive() {
      try {
        // any checked checkboxes/radios inside filter groups
        var anyChecked =
          document.querySelectorAll(
            '.accordion-body input[type="checkbox"]:checked, .accordion-body input[type="radio"]:checked'
          ).length > 0;
        if (anyChecked) return true;

        // price slider: if present and not default (assumes slider sets hidden inputs or updates UI)
        var priceSlider = document.getElementById('price-slider');
        if (priceSlider && window.noUiSlider && priceSlider.noUiSlider) {
          try {
            var vals = priceSlider.noUiSlider.get();
            // default in this theme is [0,200000]
            if (Array.isArray(vals)) {
              var a = Number(String(vals[0]).replace(/[^0-9.-]/g, '')) || 0;
              var b = Number(String(vals[1]).replace(/[^0-9.-]/g, '')) || 200000;
              if (a > 0 || b < 200000) return true;
            }
          } catch (e) {}
        }

        // filterAdded tags
        var filterTags = document.querySelectorAll('.filterAdded > span').length > 0;
        if (filterTags) return true;
      } catch (e) {}
      return false;
    }

    function updateFilterIndicator() {
      var el = document.getElementById('filterLinkToggle');
      if (!el) return;
      if (filtersAreActive()) el.classList.add('indicatorGreen');
      else el.classList.remove('indicatorGreen');
    }

    // wire common events that can change filters
    document.addEventListener(
      'change',
      function (e) {
        if (
          e.target &&
          (e.target.matches('.accordion-body input[type="checkbox"]') ||
            e.target.matches('.accordion-body input[type="radio"]'))
        )
          updateFilterIndicator();
      },
      true
    );

    // price slider change: if noUiSlider present, listen for 'change' on its instance
    document.addEventListener('DOMContentLoaded', function () {
      var ps = document.getElementById('price-slider');
      if (ps && ps.noUiSlider && typeof ps.noUiSlider.on === 'function') {
        ps.noUiSlider.on('change', updateFilterIndicator);
      }
      // also observe DOM changes in .filterAdded (tags added/removed)
      var fa = document.querySelector('.filterAdded');
      if (fa) {
        var mo = new MutationObserver(updateFilterIndicator);
        mo.observe(fa, { childList: true, subtree: true });
      }

      // initial check
      updateFilterIndicator();
    });

    // Also update when pagination or other scripts modify DOM
    window.addEventListener('popstate', updateFilterIndicator);
  })();
</script>

<script>
  // Helper: update displayed price on a product card based on selected color/size
  function updateCardPrice(card, variants, opts) {
    try {
      opts = opts || {};
      const color = (opts.color || '').toString().trim().toLowerCase();
      const size = (opts.size || '').toString().trim().toLowerCase();
      // Filter matching variants by provided attributes. If an attribute is empty, it's ignored.
      let matches = variants.filter((v) => {
        const vColor = (v.option1 || '').toString().trim().toLowerCase();
        const vSize = (v.option2 || '').toString().trim().toLowerCase();
        if (color && vColor !== color) return false;
        if (size && vSize !== size) return false;
        return true;
      });
      // If no matches found and color provided, fall back to color-only matches, then to any available variant
      if (matches.length === 0 && color) {
        matches = variants.filter((v) => (v.option1 || '').toString().trim().toLowerCase() === color);
      }
      if (matches.length === 0) matches = variants.slice();

      // Pick lowest price among matches
      let lowest = null;
      matches.forEach((v) => {
        // Variant price may be provided in different shapes (string/number, cents or units).
        let priceRaw = v.price || v.compare_at_price || v.presentment_price || 0;
        let price = Number(priceRaw);
        if (isNaN(price)) {
          // try parsing string with decimal
          price = parseFloat((priceRaw || '').toString().replace(/[^0-9.\-]/g, '')) || 0;
        }
        // Heuristic: if price looks like cents (divisible by 100 and > 1000), convert to units
        if (price >= 1000 && Math.round(price) % 100 === 0) {
          price = price / 100;
        }
        if (lowest === null || price < lowest) lowest = price;
      });
      if (lowest === null) return; // nothing to show

      // price value element
      const priceEl = card.querySelector('.priceValue');
      if (!priceEl) return;

      // Format INR without currency symbol and without decimals (match existing markup)
      const formatted = Math.round(lowest).toLocaleString('en-IN');
      priceEl.textContent = formatted;
    } catch (e) {
      // ignore failures
    }
  }
</script>
