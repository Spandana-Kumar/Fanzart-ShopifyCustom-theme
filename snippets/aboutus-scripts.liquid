<script
  src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/SplitText.min.js"
  integrity="sha512-wOeEC+9qERAzhliwBFPDb6t8TiFFxdxG8vhK/Ygs7TuC44bpg8pg/X2/U/u+0X4fK05wb9id1EIipnF02+CFQw=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
></script>

<script>
  gsap.registerPlugin(SplitText, ScrollTrigger);

  if (window.innerWidth >= 768) {
    // Image rotation
    gsap.to('#img', {
      rotate: -180,
      duration: 1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '.about__section',
        start: 'top 60%',
        end: 'bottom 30%',
        toggleActions: 'play reverse play reverse',
      },
    });

    // Text reveal (color fade from gray to black)
    document.querySelectorAll('.revealText').forEach((el) => {
      const split = new SplitText(el, { type: 'words' });

      // Set initial gray color
      gsap.set(split.words, { color: '#999' });

      // Animate to black as each line scrolls into view
      gsap.to(split.words, {
        color: '#121212',
        stagger: 0.08,
        duration: 0.2,
        ease: 'power1.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%', // start revealing just before entering view
          toggleActions: 'play none none reverse',
        },
      });
    });
  }

  // Banner title animation
  let splitTitle = new SplitText('.animated', { type: 'words' });

  gsap.from(splitTitle.words, {
    x: -40,
    opacity: 0,
    autoAlpha: 0,
    stagger: 0.05,
    duration: 0.8,
    ease: 'power2.out',
  });
</script>

   <script>
        const tabButtons = document.querySelectorAll(".tabBtn");
        const tabContents = document.querySelectorAll(".tabContent");
        const nextBtn = document.getElementById("nextTab");
        const prevBtn = document.getElementById("prevTab");
        const timelineContainer = document.querySelector(".timeline_buttons");

        let currentTabIndex = 0;

        // Click on tab buttons
        tabButtons.forEach((button, index) => {
            button.addEventListener("click", () => {
                currentTabIndex = index;
                const tabId = button.dataset.tab;
                setActiveTab(tabId);
            });
        });

        // Next button
        nextBtn.addEventListener("click", () => {
            if (currentTabIndex < tabButtons.length - 1) {
                currentTabIndex++;
                const nextTabId = tabButtons[currentTabIndex].dataset.tab;
                setActiveTab(nextTabId);
            }
        });

        // Prev button
        prevBtn.addEventListener("click", () => {
            if (currentTabIndex > 0) {
                currentTabIndex--;
                const prevTabId = tabButtons[currentTabIndex].dataset.tab;
                setActiveTab(prevTabId);
            }
        });

        // Function to update tab and buttons
        function setActiveTab(tabId) {
            tabButtons.forEach((btn) =>
                btn.classList.toggle("active", btn.dataset.tab === tabId)
            );

            tabContents.forEach((content) =>
                content.classList.toggle("active", content.dataset.tab === tabId)
            );

            // Disable or enable buttons at the edges
            prevBtn.disabled = currentTabIndex === 0;
            nextBtn.disabled = currentTabIndex === tabButtons.length - 1;

            // Scroll the active tab into view (to the left side)
            const activeButton = tabButtons[currentTabIndex];
            const containerRect = timelineContainer.getBoundingClientRect();
            const buttonRect = activeButton.getBoundingClientRect();

            // Calculate how far to scroll so that active tab aligns to left
            const scrollLeftPos =
                timelineContainer.scrollLeft +
                (buttonRect.left - containerRect.left) -
                10; // small padding

            timelineContainer.scrollTo({
                left: scrollLeftPos,
                behavior: "smooth",
            });
        }

        // Initialize first tab
        setActiveTab(tabButtons[0].dataset.tab);

        // Optional: make timeline draggable
        let isDown = false;
        let startX;
        let scrollLeft;

        timelineContainer.addEventListener("mousedown", (e) => {
            isDown = true;
            timelineContainer.classList.add("dragging");
            startX = e.pageX - timelineContainer.offsetLeft;
            scrollLeft = timelineContainer.scrollLeft;
        });

        timelineContainer.addEventListener("mouseleave", () => {
            isDown = false;
            timelineContainer.classList.remove("dragging");
        });

        timelineContainer.addEventListener("mouseup", () => {
            isDown = false;
            timelineContainer.classList.remove("dragging");
        });

        timelineContainer.addEventListener("mousemove", (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - timelineContainer.offsetLeft;
            const walk = (x - startX) * 1.5; // scroll speed
            timelineContainer.scrollLeft = scrollLeft - walk;
        });
    </script>
<script>
  if (window.innerWidth >= 768) {
    const images = document.querySelectorAll('.img_wrap .img');
    const listItems = document.querySelectorAll('.listing li');

    images.forEach((img, i) => img.classList.toggle('show', i === 0));
    listItems.forEach((li, i) => li.classList.toggle('active', i === 0));

    listItems.forEach((li, index) => {
      li.addEventListener('mouseenter', () => {
        images.forEach((img) => img.classList.remove('show'));
        listItems.forEach((item) => item.classList.remove('active'));
        images[index].classList.add('show');
        li.classList.add('active');
      });
    });
  }
</script>

