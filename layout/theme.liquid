<!DOCTYPE html>
<html lang="{{ shop.locale }}">


<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ page_description | escape }}">
  <title>{{ page_title }}</title>

 {% render 'favicon' %}

{% if request.path == '/collections' %}
