<section class="related__fans__wrapper">
  <div class="container">
    <h2 class="title32 txtDark">Related Fans</h2>
    <div class="swiper mySwiper relatedSwiper">
      <div class="swiper-wrapper">
        {% assign current_collection = product.collections.first %}
        {% if current_collection %}
          {% for related_product in current_collection.products limit:8 %}
            {% if related_product.id != product.id %}
              <div class="swiper-slide">
                <a href="{{ related_product.url }}" class="related_card">
                  <img src="{{ related_product.variants.first.featured_image | image_url: width: 400 }}" alt="{{ related_product.title }}" />
                  <p>{{ related_product.title }}</p>
                  <h6><span>&#8377;</span> {{ related_product.variants.first.price | money_without_trailing_zeros }}</h6>
                </a>
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>
