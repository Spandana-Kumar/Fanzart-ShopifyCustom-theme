<section class="choose__it__wrapper">
  {% if section.settings.background_image %}
    <img src="{{ section.settings.background_image | image_url: width: 2000 }}" class="bg" alt="" />
    <img src="{{ section.settings.background_image | image_url: width: 2000 }}" class="bg-mobile" alt="" />
  {% endif %}
  <div class="contents">
    <h2 class="title42 txtWhite" data-aos="fade-up" data-aos-duration="1000">
      {{ section.settings.heading }}
    </h2>
    <p class="font_18 txtWhite-2" data-aos="fade-up" data-aos-duration="1500">
      {{ section.settings.description }}
    </p>
    <a href="{{ section.settings.button_link }}" class="btns btnWhite" data-aos="fade-up" data-aos-duration="2000">
      <div class="bg"></div>
      <div class="btnText">
        <span>{{ section.settings.button_text }}</span>
        <span>{{ section.settings.button_text }}</span>
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Product Showroom",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See It. Feel It. Choose It."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Because choosing a fan isn’t just about function. It’s about finding a piece that belongs in your world."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore over 45+ showrooms"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
      
    }
  ],
  "presets": [
    {
      "name": "Showroom Section",
   
    }
  ]
}
{% endschema %}
