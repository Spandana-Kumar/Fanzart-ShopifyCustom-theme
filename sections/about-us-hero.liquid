<section class="hero__banner__wrapper">
  {% if section.settings.background_image %}
    <img src="{{ section.settings.background_image | image_url }}" alt="Banner" />
  {% endif %}
  <div class="contents">
    <h1 class="title56 txtWhite animated">{{ section.settings.heading }}</h1>
    <p class="font_20 txtWhite-2 animated">{{ section.settings.subtext1 }}</p>
    <p class="font_20 txtWhite-2 animated">{{ section.settings.subtext2 }}</p>
  </div>
</section>



{% schema %}
{
  "name": "About Us Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Where Air Becomes Art"
    },
    {
      "type": "text",
      "id": "subtext1",
      "label": "Subtext Line 1",
      "default": "We don’t just make fans design."
    },
    {
      "type": "text",
      "id": "subtext2",
      "label": "Subtext Line 2",
      "default": "We shape silence, style, and atmosphere through form, finish, & intelligence."
    }
  ]
}
{% endschema %}
