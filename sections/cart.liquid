{% if cart.item_count == 0 %}
  <section class="cart__empty__wrapper">
    <div class="container">
      <div class="empty_flex">
        {% if section.settings.empty_image != blank %}
          <img
            src="{{ section.settings.empty_image | image_url }}"
            class="img"
            alt="Empty cart"
          >
        {% else %}
          <img
            src="{{ 'cart-empty.png' | asset_url }}"
            class="img"
            alt="Empty cart"
          >
        {% endif %}

        <div class="empty_text">
          <h4>{{ section.settings.heading }}</h4>
          <p>{{ section.settings.description }}</p>
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="btns btnDark"
          data-aos="fade-up"
          data-aos-duration="2000"
        >
          <div class="bg"></div>
          <div class="btnText">
            <span>{{ section.settings.button_text }}</span>
            <span>{{ section.settings.button_text }}</span>
          </div>
        </a>
      </div>
    </div>
  </section>

{% else %}
  <section class="cart__wrapper">
    <div class="container">
      <div class="row">
        <div class="col-12 col-md-7 col-lg-8 col-xl-7">
          <div class="cart_title">
            <h2>Your cart</h2>
            {% assign product_count = cart.item_count %}
            {% for item in cart.items %}
              {% if item.product.title == 'Installation Fee' %}
                {% assign product_count = product_count | minus: 1 %}
              {% endif %}
            {% endfor %}
            <div class="count">
              <span>{{ product_count }}</span> Products
            </div>
          </div>

          <!-- Product Card -->
          {% for item in cart.items %}
            {% if item.product.title == 'Installation Fee' %}
              <div class="cart__item installation-item">
                <span class="cart__item-title">{{ item.product.title }}</span>
                <span class="cart__item-price">{{ item.final_line_price | money }}</span>
              </div>
            {% else %}
              {%- assign housing = item.variant.metafields.custom.housing -%}
              {%- assign blade = item.variant.metafields.custom.blade -%}
              {%- assign color = item.variant.option1 -%}
              {% assign sweep = item.properties.Sweep | strip %}
              {% assign watt = item.properties.Watt | strip %}

              {%- comment -%}
                Build custom tracking key (Colour + Sweep + Watt only)
              {%- endcomment -%}
              {% assign tracking_key = color | append: '-' | append: sweep | append: '-' | append: watt %}

              <div
                class="product_card"
                data-tracking-key="{{ tracking_key }}"
                data-line="{{ forloop.index }}"
                data-variant-id="{{ item.variant_id }}"
              >
                <div class="product_img">
                  <img src="{{ item.image | img_url: 'medium' }}" alt="{{ item.product.title }}">
                </div>
                <div class="contents_flex">
                  <div class="deatails">
                    <h3>{{ item.product.title }}</h3>
                    <div class="inner_flex">
                      <ul class="product_detail_list">
                        <!-- COLOUR -->
                        {% if housing or blade %}
                          <li>
                            <h5>COLOUR</h5>
                            <h6>
                              {% if housing -%}
                                Housing: {{ housing -}}
                                <br>
                              {% endif %}
                              {% if blade %}Blades: {{ blade }}{% endif %}
                            </h6>
                          </li>
                        {% elsif color %}
                          <li>
                            <h5>COLOUR</h5>
                            <h6>{{ color }}</h6>
                          </li>
                        {% endif %}

                        <!-- SWEEP -->
                        {% if sweep != blank %}
                          <li>
                            <h5>SWEEP</h5>
                            <h6>{{ sweep }}</h6>
                          </li>
                        {% endif %}

                        <!-- WATT -->
                        {% if watt != blank %}
                          <li>
                            <h5>WATT</h5>
                            <h6>{{ watt }}</h6>
                          </li>
                        {% endif %}

                        <!-- Other properties -->
                        {% for property in item.properties %}
                          {% assign label = property.first %}
                          {% assign value = property.last %}
                          {% assign label_down = label | downcase %}

                          {% unless label_down contains 'sweep'
                            or label_down == 'watt'
                            or label_down == 'custom image'
                            or label_down == 'custom price'
                            or label_down == 'custom label'
                            or label_down == 'colour'
                            or label_down == 'color'
                            or label_down == 'add on price'
                            or value == blank
                          %}
                            {% assign label_final = label
                              | replace: 'color', 'colour'
                              | replace: 'Color', 'Colour'
                              | upcase
                            %}

                            <li>
                              <h5>{{ label_final }}</h5>
                              <h6>{{ value }}</h6>
                            </li>
                          {% endunless %}
                        {% endfor %}
                      </ul>

                      <div class="actionBtn_flex">
                        <div class="wishList_wrap cart_wishlist_dropdown" id="wishListBtn">
                          <button
                            class="likes actionBtn add-to-wishlist"
                            data-id="{{ item.product.id }}"
                            data-variant-id="{{ item.variant_id }}"
                            data-title="{{ item.product.title | escape }}"
                            data-product-handle="{{ item.product.handle }}"
                            data-image="{{ item.image | img_url: '600x' }}"
                            data-price="{{ item.final_line_price | money }}"
                            data-handle="{{ item.product.handle }}"
                            aria-label="Add to wishlist"
                          >
                            <span class="img"></span>
                            <span>Wishlist</span>
                          </button>

                          <div class="wishlist-dropdown">
                            <div class="wishlist-inner">
                              <div class="list"></div>
                              <div class="list-create">
                                <div class="create-btn">Create a New Project</div>
                              </div>
                            </div>
                          </div>
                        </div>

                        <button
                          class="actionBtn remove-btn"
                          data-bs-toggle="modal"
                          data-bs-target="#removeProduct"
                          data-product-id="{{ item.key }}"
                          data-tracking-key="{{ tracking_key }}"
                          data-product-title="{{ item.product.title }}"
                          data-product-image="{{ item.image | img_url: 'medium' }}"
                          data-product-price="{{ item.final_line_price | money_without_trailing_zeros }}"
                        >
                          <img src="{{ 'img_cart_trash.svg' | asset_url }}" alt="Remove">
                          <span>Remove</span>
                        </button>
                      </div>
                    </div>
                  </div>
                  <div class="count_prices_flex">
                    <div class="counter">
                      <form method="post" action="/cart/change">
                        <input type="hidden" name="id" value="{{ item.key }}">

                        <button
                          class="decrease"
                          {% if item.quantity == 1 %}
                            disabled
                          {% endif %}
                        >
                          <img src="{{ 'img_cart_minus.svg' | asset_url }}" class="icon" alt="-">
                        </button>

                        <span class="count">{{ item.quantity }}</span>

                        <!-- Increase -->
                        <button
                          class="increase"
                          data-tracking-key="{{ tracking_key }}"
                          data-available="{{ item.variant.inventory_quantity }}"
                          {% if item.variant.inventory_management
                            and item.variant.inventory_policy == 'deny'
                            and item.quantity >= item.variant.inventory_quantity
                          %}
                            disabled
                          {% endif %}
                        >
                          <img src="{{ 'img_cart_plus.svg' | asset_url }}" class="icon" alt="+">
                        </button>
                        <input type="hidden" name="quantity" value="{{ item.quantity }}">
                      </form>
                    </div>

                    <div class="prices">
                      <div class="mrpItem">
                        <div class="mrp">
                          <h6>MRP:</h6>
                          <div>
                            {% assign addon_price = item.properties['Add On Price'] %}
                            {% if addon_price %}
                              {% assign addon_price_paise = addon_price | times: 100 %}
                              {% assign addon_total = item.final_line_price | plus: addon_price_paise %}
                              <span>&#8377;</span
                              ><span>{{ addon_total | money_without_currency | split: '.' | first }}</span>
                            {% else %}
                              <span>&#8377;</span
                              ><span>{{ item.final_line_price | money_without_currency | split: '.' | first }}</span>
                            {% endif %}
                          </div>
                        </div>
                        <p>(Inclusive all of taxes)</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="col-12 col-md-5 col-lg-4 col-xl-4 offset-xl-1">
          <div class="order__summary__wrapper">
            {% assign total_mrp = 0 %}
            {% assign summary_product_count = 0 %}
            {% for item in cart.items %}
              {% if item.product.title == 'Installation Fee' %}
                {%- comment -%} Skip installation fee from total {%- endcomment -%}
              {% else %}
                {% assign summary_product_count = summary_product_count | plus: 1 %}
                {% assign addon_price = item.properties['Add On Price'] %}
                {% if addon_price %}
                  {% assign addon_price_paise = addon_price | times: 100 %}
                  {% assign addon_total = item.final_line_price | plus: addon_price_paise %}
                  {% assign total_mrp = total_mrp | plus: addon_total %}
                {% else %}
                  {% assign total_mrp = total_mrp | plus: item.final_line_price %}
                {% endif %}
              {% endif %}
            {% endfor %}

            <h3>Order Summary</h3>
            <div class="product_mrp_flex">
              <div class="inner_flex">
                <div class="item">MRP ({{ summary_product_count }} Products)</div>
                <div class="rate">
                  <span>&#8377;</span
                  ><span id="orderMrp">{{ total_mrp | money_without_currency | split: '.' | first }}</span>
                </div>
              </div>

              <div class="inner_flex">
                <div class="item">Shipping</div>
                <div class="rate">Free</div>
              </div>
            </div>

            <div class="availability_wrap">
              <h4>Check availability for installation</h4>

              <div class="pinCode">
                <input
                  type="text"
                  id="pincodeInput"
                  class="controls"
                  placeholder="Pin code"
                  maxlength="6"
                  inputmode="numeric"
                >
                <div class="successText" style="display:none;">Installation service is available.</div>
                <div class="errorText" style="display:none;">Installation service is unavailable.</div>
              </div>

              <div class="installation">
                <div class="checkbox_wrap">
                  <div class="checkbox">
                    <input type="checkbox" name="checkboxs" id="checkboxs" class="cstm-chk">
                    <label for="checkboxs">Add Installation Fee</label>
                  </div>
                  <div class="tooltip_wrap">
                    <img src="{{ 'img_cart_Info.svg' | asset_url }}" class="info" alt="">

                    <div class="tooltipText">
                      {{ shop.metafields.custom.installation_tooltip }}
                      <a
                        href="javascript:void();"
                        data-bs-toggle="modal"
                        data-bs-target="#modalTooltip"
                        >Read More.</a
                      >
                    </div>
                  </div>
                </div>
                <div class="installationFee"><span>&#8377;</span><span id="installationFeeValue">0</span></div>
              </div>
            </div>

            <div class="total_price_flex">
              <div class="total">
                <h4>Total</h4>
                <div>
                  <span>&#8377;</span
                  ><span id="totalValue">{{ initial_total_cents | money_without_currency | split: '.' | first }}</span>
                </div>
              </div>
            </div>

            <div class="floation_button">
              <!-- Only for Mobile (Desktop screen not required only its show in mobile) -->
              <div class="mrpMobile">
                <h4>
                  <span class="mrp">Total</span>
                  <span>&#8377;</span
                  ><span id="mrpMobileValue">
                    {{- initial_total_cents | money_without_currency | split: '.' | first -}}
                  </span>
                </h4>
              </div>
              <!-- Only for Mobile -->
              <a
                href="javascript:"
                class="btns btnDark btnProceed"
                id="proceedToPayBtn"
              >
                <div class="bg"></div>
                <div class="btnText">
                  <span>Proceed to Pay</span>
                  <span>Proceed to Pay</span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- whishlist Toast -->
    <div class="tooltip-msg">
      <div class="container">
        <div class="tooltip-msg-inn">
          <span class="tooltip-text">Product successfully added to 'Project - 2'</span>
          <a href="javascript:" class="undoBtn">UNDO</a>
          <span class="tooltip-close">
            <img src="{{ 'img_icons_x.svg' | asset_url }}" alt="">
          </span>
        </div>
      </div>
    </div>

    <!-- Popup for New Project -->
    <div class="popup-overlay">
      <div class="popup-box">
        <h4>Create a Wishlist</h4>

        <div class="form-group">
          <input type="text" id="new-wishlist-name" placeholder="Enter wishlist name">
          <div class="wishlist-error-msg ">Please enter a wishlist name</div>
        </div>
        <div class="btn-wrap">
          <button id="closePopup-wishlist" class="btns btnWhite">
            <div class="bg"></div>
            <div class="btnText">
              <span>Cancel</span>
              <span>Cancel</span>
            </div>
          </button>
          <button id="add-wishlist" class="btns btnDark">
            <div class="bg"></div>
            <div class="btnText">
              <span>Create</span>
              <span>Create</span>
            </div>
          </button>
        </div>
      </div>
    </div>
  </section>
  <style>
    {% render 'sml-client-css' %}
  </style>
  {% render 'sml-main' %}
  <script>
    {% render 'sml-client-js' %}
  </script>

  <form id="customer_login" style="display:none !important;"></form>

  <!-- Login Modal -->
  <div
    class="modal logIn_modal fade"
    id="loginModal"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    tabindex="-1"
    aria-labelledby="loginModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
          <img src="{{ 'img_cart_close.svg' | asset_url }}" alt="close">
        </button>
        <div class="modal-body">
          <div class="logIn_bg">
            <img src="{{ 'img_cart_logIn.png' | asset_url }}" alt="logIn">
          </div>

          <div class="logIn_form">
            <div class="inner_wrap" id="logInBlock">
              <div class="title">
                <h3>Log In</h3>
                <p>Get access to your orders</p>
              </div>

              <form action="" class="form">
                <div class="logIn_field">
                  <label for="phone">Enter 10 digit Mobile Number</label>
                  <input type="text" class="controls" name="phone" id="phone">
                  <div class="waring" id="warningMsg">Please enter a valid 10-digit mobile number.</div>
                </div>
                <button type="button" id="logInNum" class="btns btnDark">
                  <div class="bg"></div>
                  <div class="btnText">
                    <span>Get Verification Code</span>
                    <span>Get Verification Code</span>
                  </div>
                </button>

                <div class="deviderLine">
                  <div class="line"></div>
                  <div class="text">or</div>
                  <div class="line"></div>
                </div>

                <button type="button" class="btns btnWhite" id="guestCheckoutBtn">
                  <div class="bg"></div>
                  <div class="btnText">
                    <span>Checkout as a Guest</span>
                    <span>Checkout as a Guest</span>
                  </div>
                </button>
              </form>

              <div class="contents">
                <p>By logging in, you agree to our</p>
                <ul class="linksList">
                  <li><a href="{{ pages['terms-and-conditions'].url }}">Terms and Conditions</a></li>
                  <li><span>&</span></li>
                  <li><a href="{{ pages['privacy-policy'].url }}">Privacy Policy</a></li>
                </ul>
              </div>
            </div>

            <div class="otp_wrapper" id="otpBlock" style="display:none;">
              <div class="title">
                <h3>Verify OTP</h3>
                <p>Provide OTP sent to <strong id="displayNumber"></strong> <a href="#" id="editNumber">Edit</a></p>
              </div>
              <form action="" id="otpForm">
                <div class="logIn_field">
                  <label for="otpInputs">Enter the verification code here</label>
                  <div class="otp_inputs" id="otpInputs">
                    <input type="text" class="otpControls" maxlength="1">
                    <input type="text" class="otpControls" maxlength="1">
                    <input type="text" class="otpControls" maxlength="1">
                    <input type="text" class="otpControls" maxlength="1">
                  </div>

                  <div id="otpErrorMsg" style="color:red; display:none; font-size:12px; margin-top:5px;">
                    Invalid OTP. Please try again.
                  </div>
                </div>

                <p class="resendCounter">Didn't get the code? Resend in <span id="resendTimer">00:30</span></p>
                <p class="resend_text" style="display:none;">
                  Didn't get the code? <br>
                  <a href="#" id="resendSMS">Resend code on SMS</a>
                </p>
              </form>
              <div class="contents">
                <p>By logging in, you agree to our</p>
                <ul class="linksList">
                  <li><a href="{{ pages['terms-and-conditions'].url }}">Terms and Conditions</a></li>
                  <li><span>&</span></li>
                  <li><a href="{{ pages['privacy-policy'].url }}">Privacy Policy</a></li>
                </ul>
              </div>
            </div>
            <div class="email_wrapper inner_wrap" id="emailBlock" style="display:none;">
              <div class="title">
                <h3>Enter Your Email</h3>
                <p>We need your email to complete your login</p>
              </div>
              <form id="emailForm">
                <div class="logIn_field">
                  <label for="userEmail">Email Address</label>
                  <input
                    type="email"
                    class="controls"
                    name="userEmail"
                    id="userEmail"
                    placeholder="Enter your email"
                    required
                  >
                </div>
                <button type="submit" id="submitEmail" class="btns btnDark">
                  <div class="bg"></div>
                  <div class="btnText">
                    <span>Done</span>
                    <span>Done</span>
                  </div>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="modal modal_remove fade"
    id="removeProduct"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    tabindex="-1"
    aria-labelledby="removeProductLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title" id="removeProductLabel">Are you sure you want to remove this product from cart?</h1>
        </div>

        <div class="modal-body">
          <div class="product_remove">
            <img src="" id="modal-product-image" class="img" alt="Product image">
            <div class="contents">
              <h5 id="modal-product-title">Product Name</h5>
              <p>Carved in wood. Composed in silence.</p>
              <div class="mrp">
                <h6>MRP: <span>&#8377;</span><span id="modal-product-price">0</span></h6>
                <p>(Inclusive all of taxes)</p>
              </div>
            </div>
          </div>

          <!-- Hidden input to store product ID -->
          <input type="hidden" id="remove-product-id">
        </div>

        <div class="modal-footer">
          <button type="button" class="btns btnWhite" data-bs-dismiss="modal">
            <div class="bg"></div>
            <div class="btnText">
              <span>Cancel</span>
              <span>Cancel</span>
            </div>
          </button>

          <button
            type="button"
            class="btns btnDark"
            data-bs-dismiss="modal"
            onclick="handleRemoveClick()"
            id="confirm-remove-btn"
          >
            <div class="bg"></div>
            <div class="btnText">
              <span>Remove</span>
              <span>Remove</span>
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="toast" class="toastUndo">
    <div class="flex_wrap">
      <p>Product is removed from cart</p>
      <button class="btnUndo" onclick="undoAction()">UNDO</button>
    </div>

    <button class="close" onclick="hideToast()">
      <img src="{{ 'img_cart_undo.svg' | asset_url }}" alt="">
    </button>
  </div>

  <!-- ToolTip Modal -->
  <div
    class="modal modalTooltip fade"
    id="modalTooltip"
    tabindex="-1"
    aria-labelledby="modalTooltipLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        <div class="modal-body">
          {{ shop.metafields.custom.installation_terms | raw }}
        </div>
      </div>
    </div>
  </div>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let resendTimerInterval;
    let otpStartTime = null;
    const otpValidDuration = 30; // seconds

    function clearOTPInputs() {
      document.querySelectorAll('#otpInputs .otpControls').forEach((i) => (i.value = ''));
    }

    function isOtpExpired() {
      if (!otpStartTime) return true;
      const elapsed = (Date.now() - otpStartTime) / 1000;
      return elapsed > otpValidDuration;
    }

    function startResendCountdown(seconds = 30) {
      otpStartTime = Date.now(); // Reset OTP timer start
      clearInterval(resendTimerInterval);

      const counter = document.querySelector('.resendCounter');
      const timerSpan = document.getElementById('resendTimer');
      const resendText = document.querySelector('.resend_text');

      if (!counter || !timerSpan || !resendText) return;

      counter.style.display = 'block';
      resendText.style.display = 'none';

      let remaining = seconds;

      function updateTimer() {
        const mm = String(Math.floor(remaining / 60)).padStart(2, '0');
        const ss = String(remaining % 60).padStart(2, '0');
        timerSpan.textContent = `${mm}:${ss}`;

        if (remaining <= 0) {
          clearInterval(resendTimerInterval);
          counter.style.display = 'none';
          resendText.style.display = 'block';
        }
        remaining--;
      }

      updateTimer();
      resendTimerInterval = setInterval(updateTimer, 1000);
    }

    // STEP 1: Send OTP
    document.getElementById('logInNum').addEventListener('click', function () {
      const phone = document.getElementById('phone').value.trim();

      if (!/^[6-9]\d{9}$/.test(phone)) {
        document.getElementById('warningMsg').style.display = 'block';
        return;
      }
      document.getElementById('warningMsg').style.display = 'none';

      document.getElementById('smlPhoneNumberInput').value = phone;
      document.getElementById('getOTPButton').click();

      document.getElementById('displayNumber').innerText = phone;
      document.getElementById('logInBlock').style.display = 'none';
      document.getElementById('otpBlock').style.display = 'block';

      clearOTPInputs();
      startResendCountdown(30);

      document.querySelector('#otpInputs .otpControls')?.focus();

      const otpError = document.getElementById('otpErrorMsg');
      if (otpError) otpError.style.display = 'none';
    });

    // STEP 2: Capture OTP and validate
    document.querySelectorAll('#otpInputs .otpControls').forEach((input, idx, arr) => {
      input.addEventListener('input', function () {
        if (this.value.length === 1 && idx < arr.length - 1) arr[idx + 1].focus();

        const otp = Array.from(arr)
          .map((i) => i.value)
          .join('');

        if (otp.length === 4) {
          const otpError = document.getElementById('otpErrorMsg');

          if (isOtpExpired()) {
            otpError.style.display = 'block';
            otpError.textContent = 'OTP expired. Please request a new one.';
            clearOTPInputs();
            return;
          }

          otpError.style.display = 'none';
          document.getElementById('otpInput').value = otp;
          document.getElementById('submitOTPButton').click();
        }
      });
    });

    // STEP 3: Email for new users
    document.getElementById('emailForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const email = document.getElementById('userEmail').value.trim();
      if (!email) return;
      localStorage.setItem('sml_user_email', email);
      document.getElementById('userEmailInput').value = email;
      document.getElementById('registerUserButton').click();
    });

    // STEP 4: Edit number
    document.getElementById('editNumber').addEventListener('click', function (e) {
      e.preventDefault();
      document.getElementById('otpBlock').style.display = 'none';
      document.getElementById('logInBlock').style.display = 'block';
      clearOTPInputs();
      clearInterval(resendTimerInterval);
    });

    // STEP 5: Resend OTP
    document.getElementById('resendSMS').addEventListener('click', function (e) {
      e.preventDefault();
      clearOTPInputs();
      document.getElementById('resendOTPButton').click();

      otpStartTime = Date.now();
      startResendCountdown(30);

      const otpError = document.getElementById('otpErrorMsg');
      if (otpError) otpError.style.display = 'none';
    });

    // STEP 6: Hook into SML events
    window.runOnSMLEvent = function (event, data) {
      console.log('SML Event:', event, data);

      if (event === 'PHONE_OTP_SCREEN_TYPE_CHANGE') {
        if (data.screen_type === 'ENTER_OTP') {
          document.getElementById('logInBlock').style.display = 'none';
          document.getElementById('otpBlock').style.display = 'block';
          clearOTPInputs();
          startResendCountdown(30);
          const otpError = document.getElementById('otpErrorMsg');
          if (otpError) otpError.style.display = 'none';
        }
        if (data.screen_type === 'ENTER_EMAIL') {
          document.getElementById('otpBlock').style.display = 'none';
          document.getElementById('emailBlock').style.display = 'block';
          clearInterval(resendTimerInterval);
        }
      }

      if (event === 'LOGIN_SUCCESSFUL' || event === 'USER_REGISTERED_SUCCESSFULLY') {
        if (data && data.email) {
          localStorage.setItem('sml_user_email', data.email);
        }
        localStorage.setItem('sml_login_time', Date.now());
        try {
          window.dispatchEvent(new CustomEvent('sml_user_logged_in', { detail: data || {} }));
        } catch (e) {}
        if (window.jQuery && jQuery('#loginModal').modal) {
          try {
            jQuery('#loginModal').modal('hide');
          } catch (e) {}
        }
        try {
          if (!window.location.pathname.toLowerCase().includes('checkout')) {
            window.location.href = '/checkout';
          }
        } catch (e) {}
      }
    };

    // STEP 7: AJAX OTP failure
    if (window.jQuery) {
      jQuery(document).ajaxError(function (event, jqxhr, settings, thrownError) {
        if (settings && settings.url && settings.url.includes('validateOTP')) {
          console.error('OTP API error caught:', jqxhr);
          const otpError = document.getElementById('otpErrorMsg');
          if (otpError) {
            otpError.style.display = 'block';
            otpError.textContent = 'Invalid or expired OTP. Please try again.';
          }
          clearOTPInputs();
        }
      });
    }

    // STEP 8: Timeout fallback
    document.getElementById('submitOTPButton').addEventListener('click', function () {
      setTimeout(() => {
        const otpBlock = document.getElementById('otpBlock');
        if (otpBlock && otpBlock.style.display !== 'none') {
          const otpError = document.getElementById('otpErrorMsg');
          if (otpError) {
            otpError.style.display = 'block';
            otpError.textContent = 'Invalid or expired OTP. Please try again.';
          }
        }
      }, 4000);
    });

    // STEP 9: Guest checkout
    document.getElementById('guestCheckoutBtn').addEventListener('click', function (e) {
      e.preventDefault();
      window.location.href = '/checkout';
    });
  });
</script>

<!-- Handle Proceed to Pay button - check if user is already logged in -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const proceedBtn = document.getElementById('proceedToPayBtn');
    if (!proceedBtn) return;

    proceedBtn.addEventListener('click', function (e) {
      e.preventDefault();
      
      // Check if user is already logged in via wishlist/login system
      const loginTimestamp = localStorage.getItem('sml_login_time');
      const now = Date.now();
      const session24hrs = 24 * 60 * 60 * 1000;
      
      const isLoggedIn = !!(loginTimestamp && now - loginTimestamp < session24hrs);
      
      if (isLoggedIn) {
        // User is already registered/logged in, proceed directly to checkout
        window.location.href = '/checkout';
      } else {
        // User is not logged in, show login modal
        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
          const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
          loginModal.show();
        } else if (window.jQuery && jQuery('#loginModal').modal) {
          jQuery('#loginModal').modal('show');
        }
      }
    });
  });
</script>

<!-- Autofill email at checkout -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const storedEmail = localStorage.getItem('sml_user_email');
    if (!storedEmail) return;

    function fillEmail() {
      const emailInput = document.querySelector('input#checkout_email, input#email, input[name="checkout[email]"]');
      if (emailInput && !emailInput.value) {
        emailInput.value = storedEmail;
        emailInput.dispatchEvent(new Event('input', { bubbles: true }));
        console.log('Email autofilled:', storedEmail);
        return true;
      }
      return false;
    }

    // Try immediately
    if (fillEmail()) return;

    // Fallback: observe DOM changes until email field is available
    const observer = new MutationObserver(() => {
      if (fillEmail()) {
        observer.disconnect();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>

<script>
