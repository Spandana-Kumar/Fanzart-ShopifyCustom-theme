document.addEventListener("DOMContentLoaded", function () {
  function updateStockButtons() {
    // Group by tracking key
    const groupedQuantities = {};

    document.querySelectorAll(".product_card").forEach(card => {
      const key = card.getAttribute("data-tracking-key");
      const qty = parseInt(card.querySelector("input[name=quantity]").value) || 0;

      groupedQuantities[key] = (groupedQuantities[key] || 0) + qty;
    });

    // Loop through all increase buttons
    document.querySelectorAll(".increase").forEach(btn => {
      const key = btn.getAttribute("data-tracking-key");
      const available = parseInt(btn.getAttribute("data-available"));
      const totalInCart = groupedQuantities[key] || 0;

      if (totalInCart >= available) {
        btn.disabled = true;
      } else {
        btn.disabled = false;
      }
    });
  }

  // Function to update Shopify cart
  function updateCart(line, quantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, quantity: quantity })
    })
    .then(res => res.json())
    .then(data => {
      console.log("Cart updated:", data);
      updateStockButtons();

      // Fetch fresh cart to compute MRP including any add-on properties
      fetch('/cart.js')
        .then(r => r.json())
        .then(cartData => {
          var mrpCents = 0;
          (cartData.items || []).forEach(function(it){
            var itemTotal = parseInt(it.final_line_price || 0, 10) || 0;
            var addon = 0;
            if (it.properties && it.properties['Add On Price']) {
              var parsed = parseFloat(it.properties['Add On Price']);
              if (!isNaN(parsed)) addon = Math.round(parsed * 100);
            }
            mrpCents += itemTotal + addon;
          });

          computeAndRenderTotals(mrpCents);
        })
        .catch(e => console.error('Error fetching cart.js for totals', e));
    })
    .catch(err => console.error("Cart update error:", err));
  }

  // Attach events for + and -
  document.querySelectorAll(".increase").forEach(btn => {
    btn.addEventListener("click", function () {
      const card = this.closest(".product_card");
      const input = card.querySelector("input[name=quantity]");
      const line = card.getAttribute("data-line");

      let qty = parseInt(input.value) || 0;
      qty++;

      input.value = qty;
      updateCart(line, qty);
    });
  });

  document.querySelectorAll(".decrease").forEach(btn => {
    btn.addEventListener("click", function () {
      const card = this.closest(".product_card");
      const input = card.querySelector("input[name=quantity]");
      const line = card.getAttribute("data-line");

      let qty = parseInt(input.value) || 0;
      if (qty > 1) qty--;

      input.value = qty;
      updateCart(line, qty);
    });
  });

  // Run initial
  updateStockButtons();
});
document.addEventListener("DOMContentLoaded", function () {

  /* ===============================
     CONFIG
  =============================== */

  const INSTALLATION_VARIANTS = {
    600: 42852344463427,
    4500: 42904708644931,
    6000: 42904708677699
  };

  const INSTALLATION_PRODUCT_TITLE = 'Installation Fee';

  /* ===============================
     METAFIELD (SAFE PARSE)
  =============================== */

  // Get the metafield (could be string or object)
  let installationFeesRaw =
    {{ shop.metafields.custom.installation_pincodes}};

  let installationFees = {};
  try {
    installationFees = typeof installationFeesRaw === 'string'
      ? JSON.parse(installationFeesRaw)
      : installationFeesRaw;
  } catch (e) {
    console.error("Failed to parse installation pincodes metafield", e);
    installationFees = {};
  }

  console.log("Installation fees metafield:", installationFees);
  console.log("Type:", typeof installationFees);

  /* ===============================
     ELEMENTS
  =============================== */

  const pincodeInput = document.getElementById("pincodeInput");
  const successText = document.querySelector(".successText");
  const errorText = document.querySelector(".errorText");
  const installationDiv = document.querySelector(".installation");
  const installationCheckbox = document.getElementById("checkboxs");
  const installationFeeEl = document.getElementById("installationFeeValue");

  if (!pincodeInput) return;

  let installationFee = 0;
  let currentOrderMrpCents = {{ total_mrp | default: 0 }};

  installationDiv.style.display = "none";
  installationCheckbox.disabled = true;

  /* ===============================
     INITIALIZATION - Remove installation fee if unchecked on load
  =============================== */
  
  async function initializeInstallationState() {
    const cart = await getCart();
    const installationInCart = cart.items.some(i => i.product_title === INSTALLATION_PRODUCT_TITLE);
    
    // If installation is in cart but checkbox is not checked, remove it silently
    if (installationInCart && !installationCheckbox.checked) {
      console.log("Installation found in cart but checkbox unchecked - removing it");
      await removeInstallation();
      
      // Update totals without reloading the page
      // Refetch cart and update the order MRP
      const updatedCart = await getCart();
      let mrpCents = 0;
      (updatedCart.items || []).forEach(function(it){
        if (it.product_title !== INSTALLATION_PRODUCT_TITLE) {
          var itemTotal = parseInt(it.final_line_price || 0, 10) || 0;
          var addon = 0;
          if (it.properties && it.properties['Add On Price']) {
            var parsed = parseFloat(it.properties['Add On Price']);
            if (!isNaN(parsed)) addon = Math.round(parsed * 100);
          }
          mrpCents += itemTotal + addon;
        }
      });
      currentOrderMrpCents = mrpCents;
      renderTotals();
    }
  }
  
  // Run initialization on page load
  initializeInstallationState().catch(e => console.error("Error initializing installation state:", e));

  /* ===============================
     CART HELPERS
  =============================== */

  async function getCart() {
    return fetch('/cart.js').then(r => r.json());
  }

  async function removeInstallation() {
    const cart = await getCart();
    const item = cart.items.find(i => i.product_title === INSTALLATION_PRODUCT_TITLE);
    if (!item) return;

    await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: item.key, quantity: 0 })
    });
  }
async function addInstallation(price) {
  try {
    // get variantId from mapping
    const variantId = INSTALLATION_VARIANTS[price];
    if (!variantId) {
      console.warn("No variant found for installation price:", price);
      return;
    }

    // remove existing installation if any
    await removeInstallation();

    // validate pincode
    const pincode = pincodeInput?.value?.trim();
    if (!pincode || !installationFees[pincode]) {
      console.warn("Invalid or unavailable pincode for installation:", pincode);
      return;
    }

    // prepare payload
    const payload = {
      id: variantId,
      quantity: 1,
      properties: {
        "Installation Pincode": pincode
      }
    };

    console.log("Adding installation to cart:", payload);

    // make request
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    // check response
    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}));
      console.error("Failed to add installation:", response.status, errorData);
    } else {
      console.log("Installation added successfully!");
    }

  } catch (error) {
    console.error("Error in addInstallation():", error);
  }
}


  /* ===============================
     TOTALS
  =============================== */

  function renderTotals() {
    const orderRs = Math.round(currentOrderMrpCents / 100);
    const install = installationCheckbox.checked ? installationFee : 0;
    const total = orderRs + install;

    document.getElementById("orderMrp").textContent = orderRs.toLocaleString("en-IN");
    document.getElementById("totalValue").textContent = total.toLocaleString("en-IN");
    document.getElementById("mrpMobileValue").textContent = total.toLocaleString("en-IN");
  }

  renderTotals();

  /* ===============================
     PINCODE VALIDATION
  =============================== */

  pincodeInput.addEventListener("input", function () {
    const value = this.value.replace(/\D/g, "").slice(0, 6);
    this.value = value;

    if (value.length !== 6) {
      successText.style.display = "none";
      errorText.style.display = "none";
      installationDiv.style.display = "none";
      installationCheckbox.checked = false;
      installationCheckbox.disabled = true;
      installationFee = 0;
      installationFeeEl.textContent = "0";
      removeInstallation();
      renderTotals();
      return;
    }

    if (installationFees && Object.prototype.hasOwnProperty.call(installationFees, value)) {
      installationFee = parseInt(installationFees[value], 10);
      successText.style.display = "block";
      errorText.style.display = "none";
      installationDiv.style.display = "flex";
      installationCheckbox.disabled = false;
      installationFeeEl.textContent = installationFee.toLocaleString("en-IN");
    } else {
      successText.style.display = "none";
      errorText.style.display = "block";
      installationDiv.style.display = "none";
      installationCheckbox.checked = false;
      installationCheckbox.disabled = true;
      installationFee = 0;
      installationFeeEl.textContent = "0";
      removeInstallation();
    }

    renderTotals();
  });

  /* ===============================
     CHECKBOX
  =============================== */

  installationCheckbox.addEventListener("change", async function () {
    if (this.checked && installationFee > 0) {
      await addInstallation(installationFee);
    } else {
      await removeInstallation();
    }
    renderTotals();
  });

});
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // CART wishlist logic (matches product-main behavior)
    let tooltipTimeout;

    function isLoggedIn() {
      try {
        const ts = localStorage.getItem('sml_login_time');
        if (!ts) return false;
        return Date.now() - Number(ts) < 24 * 60 * 60 * 1000;
      } catch (e) {
        return false;
      }
    }

    function getFolders() {
      return JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
    }

    function saveFolders(folders) {
      localStorage.setItem('wishlist_folders', JSON.stringify(folders));
      try {
        window.dispatchEvent(new CustomEvent('wishlist:changed', { detail: { folders: folders } }));
      } catch (e) {}
    }

    function addProductToFolder(name, product) {
      let folders = getFolders();
      let folder = folders.find((f) => f.name === name);
      if (!folder) {
        folder = { id: Date.now(), name: name, products: [] };
        folders.push(folder);
      }
      folder.products.push(product);
      saveFolders(folders);
      localStorage.removeItem('wishlist_pending_product');
      updateAllIcons(product.id || product);
    }

    function removeProductFromFolder(productId, folderName, variantId) {
      let folders = getFolders();
      let folder = folders.find((f) => f.name === folderName);
      if (folder) {
        if (variantId) {
          folder.products = folder.products.filter((p) => !(String(p.id) === String(productId) && String(p.variantId) === String(variantId)));
        } else {
          folder.products = folder.products.filter((p) => String(p.id) !== String(productId));
        }
        saveFolders(folders);
        updateAllIcons({ id: productId, variantId: variantId });
      }
    }

    function getProductFolder(productId, variantId) {
      let folders = getFolders();
      for (let folder of folders) {
        if (variantId) {
          if (folder.products.some((p) => String(p.id) === String(productId) && String(p.variantId) === String(variantId))) return folder.name;
        } else {
          if (folder.products.some((p) => String(p.id) === String(productId))) return folder.name;
        }
      }
      return null;
    }

    function showToast(msg, undoCallback = null) {
      const tooltip = document.querySelector('.tooltip-msg');
      if (!tooltip) return;
      tooltip.querySelector('.tooltip-text').textContent = msg;
      const undoBtn = tooltip.querySelector('.undoBtn');
      if (undoCallback) {
        undoBtn.style.display = 'inline-block';
        undoBtn.onclick = function () {
          undoCallback();
          tooltip.classList.remove('show');
          tooltip.style.display = 'none';
        };
      } else undoBtn.style.display = 'none';
      tooltip.style.display = 'block';
      tooltip.classList.add('show');
      clearTimeout(tooltipTimeout);
      tooltipTimeout = setTimeout(() => {
        tooltip.classList.remove('show');
        tooltip.style.display = 'none';
      }, 2500);
    }

    function renderProjects(dropdownEl) {
      const folders = getFolders();
      const inner = dropdownEl.querySelector('.wishlist-inner') || dropdownEl;
      let list = inner.querySelector('.list');
      if (!folders || folders.length === 0) {
        if (list) list.remove();
        return;
      }
      if (!list) {
        list = document.createElement('div');
        list.className = 'list';
        const createBlock = inner.querySelector('.list-create');
        if (createBlock) inner.insertBefore(list, createBlock);
        else inner.appendChild(list);
      }
      list.innerHTML = '';
      folders.forEach((folder) => {
        const option = document.createElement('div');
        option.className = 'option';
        option.textContent = folder.name;
        option.style.cursor = 'pointer';
        list.appendChild(option);
      });
    }

    function updateIconStateForCard(card) {
      const btn = card.querySelector('.likes.actionBtn');
      if (!btn) return;
      const pid = btn.getAttribute('data-id');
      const vid = btn.getAttribute('data-variant-id') || null;
      const folder = getProductFolder(pid, vid);
      btn.classList.toggle('active', !!folder);
    }

    function updateAllIcons(productRef) {
      // productRef can be {id, variantId} or a plain id
      const pid = String(productRef && productRef.id ? productRef.id : productRef || '');
      const folders = getFolders();
      document.querySelectorAll(`.likes.actionBtn[data-id="${pid}"]`).forEach((btn) => {
        const bvid = btn.getAttribute('data-variant-id') || null;
        const folder = getProductFolder(pid, bvid);
        btn.classList.toggle('active', !!folder);
      });
    }

    // Initialize state for cart items
    document.querySelectorAll('.product_card').forEach((card) => {
      const likeBtn = card.querySelector('.likes.actionBtn');
      if (!likeBtn) return;
      updateIconStateForCard(card);

      // Hide dropdowns if not logged in
      const dropdown = card.querySelector('.wishlist-dropdown');
      if (dropdown && !isLoggedIn()) dropdown.style.display = 'none';

      likeBtn.addEventListener('click', function (ev) {
        ev.preventDefault();
        ev.stopPropagation();

        const productId = likeBtn.getAttribute('data-id');
        const variantId = likeBtn.getAttribute('data-variant-id') || null;
        const existingFolder = getProductFolder(productId, variantId);
        if (existingFolder) {
          removeProductFromFolder(productId, existingFolder, variantId);
          likeBtn.classList.remove('active');
          showToast(`Product successfully removed from '${existingFolder}' in your Wishlist`, function undoAction() {
            const pending = {
              id: productId,
              handle: likeBtn.getAttribute('data-handle') || null,
              title: likeBtn.getAttribute('data-title') || '',
              image: likeBtn.getAttribute('data-image') || '',
              price: likeBtn.getAttribute('data-price') || '',
              variantId: variantId,
              options: {},
            };
            addProductToFolder(existingFolder, pending);
            updateIconStateForCard(card);
            updateAllIcons(pending);
          });
          return;
        }

        // prepare pending product from button/card
        const pending = {
          id: productId || null,
          handle: likeBtn.getAttribute('data-handle') || null,
          title:
            likeBtn.getAttribute('data-title') ||
            (card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : ''),
          image:
            likeBtn.getAttribute('data-image') ||
            (card.querySelector('.product_img img') ? card.querySelector('.product_img img').src : ''),
          price: likeBtn.getAttribute('data-price') || '',
          variantId: likeBtn.getAttribute('data-variant-id') || null,
          options: {},
        };
        localStorage.setItem('wishlist_pending_product', JSON.stringify(pending));

        if (!isLoggedIn()) {
          window.location.href = '/pages/wishlist';
          return;
        }

        if (dropdown) {
          renderProjects(dropdown);
          dropdown.classList.toggle('show');
          document.querySelectorAll('.wishlist-dropdown').forEach((dd) => {
            if (dd !== dropdown) dd.classList.remove('show');
          });
        }
      });
    });

    // Select existing project / create project click handlers (global)
    document.addEventListener('click', function (e) {
      if (e.target.classList.contains('option')) {
        e.preventDefault();
        e.stopPropagation();
        const projectName = e.target.textContent.trim();
        const pending = JSON.parse(localStorage.getItem('wishlist_pending_product') || 'null');
        if (!pending) return;
        addProductToFolder(projectName, pending);
        // update icons
        updateAllIcons(pending);
        showToast(`Product successfully added to '${projectName}'`, function undoAction() {
          removeProductFromFolder(pending.id, projectName, pending.variantId);
          updateAllIcons(pending);
        });
        const dd = e.target.closest('.wishlist-dropdown');
        if (dd) dd.classList.remove('show');
      }

      if (e.target.classList.contains('create-btn')) {
        e.stopPropagation();
        document.querySelector('.popup-overlay')?.classList.add('showPopup');
        document.body.classList.add('overflow-hidden');
        const input = document.getElementById('new-wishlist-name');
        if (input) {
          input.value = '';
          input.classList.remove('error');
        }
        document.querySelector('.wishlist-error-msg')?.classList.add('hidden');
        document.getElementById('add-wishlist')?.setAttribute('disabled', 'true');
      }
    });

    // Close dropdowns on outside click
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.wishlist-dropdown') && !e.target.classList.contains('actionBtn')) {
        document.querySelectorAll('.wishlist-dropdown').forEach((dd) => dd.classList.remove('show'));
      }
    });

    // React to storage/wishlist changes from other pages/components
    window.addEventListener('storage', function (e) {
      if (e.key === 'wishlist_folders') {
        // update all cart icons
        document.querySelectorAll('.product_card').forEach((card) => updateIconStateForCard(card));
      }
    });

    window.addEventListener('wishlist:changed', function (ev) {
      try {
        document.querySelectorAll('.product_card').forEach((card) => updateIconStateForCard(card));
      } catch (err) {}
    });

    // Wire up popup buttons (close / create) - reuse existing elements
    document.getElementById('closePopup-wishlist')?.addEventListener('click', function () {
      document.querySelector('.popup-overlay')?.classList.remove('showPopup');
      document.body.classList.remove('overflow-hidden');
    });

    document.getElementById('add-wishlist')?.addEventListener('click', function () {
      const input = document.getElementById('new-wishlist-name');
      if (!input || !input.value.trim()) {
        input?.classList.add('error');
        document.querySelector('.wishlist-error-msg')?.classList.remove('hidden');
        return;
      }
      const newName = input.value.trim();
      let pendingProduct = JSON.parse(localStorage.getItem('wishlist_pending_product') || 'null');
      let folders = getFolders();
      let exists = folders.find((f) => f.name.toLowerCase() === newName.toLowerCase());
      if (exists) {
        input.classList.add('error');
        const errorMsg = document.querySelector('.wishlist-error-msg');
        if (errorMsg) {
          errorMsg.textContent = 'Project name already exists!';
          errorMsg.classList.remove('hidden');
        }
        return;
      }
      const newFolder = { id: Date.now(), name: newName, products: pendingProduct ? [pendingProduct] : [] };
      folders.push(newFolder);
      saveFolders(folders);
      localStorage.removeItem('wishlist_pending_product');
      if (pendingProduct) updateAllIcons(pendingProduct.id);
      input.value = '';
      document.querySelector('.popup-overlay')?.classList.remove('showPopup');
      document.body.classList.remove('overflow-hidden');
      showToast(`Product successfully added to '${newName}'`);
    });

    // Validate new wishlist name input
    document.getElementById('new-wishlist-name')?.addEventListener('input', function () {
      const createBtn = document.getElementById('add-wishlist');
      const errorMsg = document.querySelector('.wishlist-error-msg');
      let folders = getFolders();
      let exists = folders.some((f) => f.name.toLowerCase() === this.value.trim().toLowerCase());
      if (this.value.trim() === '') {
        this.classList.add('error');
        if (errorMsg) errorMsg.textContent = 'Please enter a project name.';
        errorMsg?.classList.remove('hidden');
        createBtn?.setAttribute('disabled', 'true');
      } else if (exists) {
        this.classList.add('error');
        if (errorMsg) errorMsg.textContent = 'Project name already exists!';
        errorMsg?.classList.remove('hidden');
        createBtn?.setAttribute('disabled', 'true');
      } else {
        this.classList.remove('error');
        errorMsg?.classList.add('hidden');
        createBtn?.removeAttribute('disabled');
      }
    });
  });
</script>

