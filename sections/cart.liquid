{% if cart.item_count == 0 %}
   <section class="cart__empty__wrapper">
    <div class="container">
      <div class="empty_flex">
        {% if section.settings.empty_image != blank %}
          <img
            src="{{ section.settings.empty_image | image_url }}"
            class="img"
            alt="Empty cart"
          />
        {% else %}
          <img
            src="{{ 'cart-empty.png' | asset_url }}"
            class="img"
            alt="Empty cart"
          />
        {% endif %}

        <div class="empty_text">
          <h4>{{ section.settings.heading }}</h4>
          <p>{{ section.settings.description }}</p>
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="btns btnDark"
          data-aos="fade-up"
          data-aos-duration="2000"
        >
          <div class="bg"></div>
          <div class="btnText">
            <span>{{ section.settings.button_text }}</span>
            <span>{{ section.settings.button_text }}</span>
          </div>
        </a>
      </div>
    </div>
  </section>



{% else %}
  <section class="cart__wrapper">
          <div class="container">
              <div class="row">
                     <div class="col-12 col-md-7 col-lg-8 col-xl-7">
          <div class="cart_title">
            <h2>Your cart</h2>
            <div class="count"><span>{{ cart.item_count }}</span> Products</div>
          </div>

          <!-- Product Card -->
          {% for item in cart.items %}

            {%- assign housing = item.variant.metafields.custom.housing -%}
            {%- assign blade = item.variant.metafields.custom.blade -%}
            {%- assign color = item.variant.option1 -%}
            {% assign sweep = item.properties['Sweep'] | strip %}
            {% assign watt = item.properties['Watt'] | strip %}

            {%- comment -%}
              Build custom tracking key (Colour + Sweep + Watt only)
            {%- endcomment -%}
            {% assign tracking_key = color | append: '-' | append: sweep | append: '-' | append: watt %}

            <div class="product_card" <div class="product_card" 
              data-tracking-key="{{ tracking_key }}"
              data-line="{{ forloop.index }}"
              data-variant-id="{{ item.variant_id }}">
              <div class="product_img">
                <img src="{{ item.image | img_url: 'medium' }}" alt="{{ item.product.title }}" />
              </div>
              <div class="contents_flex">
                <div class="deatails">
                  <h3>{{ item.product.title }}</h3>
                  <div class="inner_flex">
                    <ul class="product_detail_list">

                      <!-- COLOUR -->
                      {% if housing or blade %}
                        <li>
                          <h5>COLOUR</h5>
                          <h6>
                            {% if housing %}Housing: {{ housing }}<br>{% endif %}
                            {% if blade %}Blades: {{ blade }}{% endif %}
                          </h6>
                        </li>
                      {% elsif color %}
                        <li>
                          <h5>COLOUR</h5>
                          <h6>{{ color }}</h6>
                        </li>
                      {% endif %}

                      <!-- SWEEP -->
                      {% if sweep != blank %}
                        <li>
                          <h5>SWEEP</h5>
                          <h6>{{ sweep }}</h6>
                        </li>
                      {% endif %}

                      <!-- WATT -->
                      {% if watt != blank %}
                        <li>
                          <h5>WATT</h5>
                          <h6>{{ watt }}</h6>
                        </li>
                      {% endif %}
                      

                      <!-- Other properties -->
                      {% for property in item.properties %}
                        {% assign label = property.first %}
                        {% assign value = property.last %}
                        {% assign label_down = label | downcase %}

                        {% unless label_down contains 'sweep' or
                                  label_down == 'watt' or
                                  label_down == 'custom image' or
                                  label_down == 'custom price' or
                                  label_down == 'custom label' or
                                  label_down == 'colour' or
                                  label_down == 'color' or
                                  label_down == 'add on price' or
                                  value == blank %}

                          {% assign label_final = label | replace: 'color', 'colour' | replace: 'Color', 'Colour' | upcase %}

                          <li>
                            <h5>{{ label_final }}</h5>
                            <h6>{{ value }}</h6>
                          </li>
                        {% endunless %}
                      {% endfor %}
                    </ul>

                    <div class="actionBtn_flex">
                      <button class="actionBtn" onclick="toggleLike(this)">
                        <span class="img"></span>
                        <span>Wishlist</span>
                      </button>

                      <button
                        class="actionBtn remove-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#removeProduct"
                        data-product-id="{{ item.key }}"
                        data-tracking-key="{{ tracking_key }}"
                        data-product-title="{{ item.product.title }}"
                        data-product-image="{{ item.image | img_url: 'medium' }}"
                        data-product-price="{{ item.final_line_price | money_without_trailing_zeros }}"
                      >
                        <img src="{{ 'img_cart_trash.svg' | asset_url }}" alt="Remove" />
                        <span>Remove</span>
                      </button>
                    </div>
                  </div>
                </div>
                <div class="count_prices_flex">
                  <div class="counter">
                    <form method="post" action="/cart/change">
                      <input type="hidden" name="id" value="{{ item.key }}">

                      <!-- Decrease -->
                      <button class="decrease" 
                        {% if item.quantity == 1 %}disabled{% endif %}
                        onclick="this.parentNode.querySelector('[name=quantity]').value={{ item.quantity | minus: 1 }}">
                        <img src="{{ 'img_cart_minus.svg' | asset_url }}" class="icon" alt="-" />
                      </button>

                      <span class="count">{{ item.quantity }}</span>

                      <!-- Increase -->
                    <button class="increase"
                      data-tracking-key="{{ tracking_key }}"
                      data-available="{{ item.variant.inventory_quantity }}"
                      {% if item.variant.inventory_management and item.variant.inventory_policy == 'deny' and item.quantity >= item.variant.inventory_quantity %}
                        disabled
                      {% endif %}>
                      <img src="{{ 'img_cart_plus.svg' | asset_url }}" class="icon" alt="+" />
                    </button>
                      <input type="hidden" name="quantity" value="{{ item.quantity }}" />
                    </form>
                  </div>

                  <div class="prices">
                    <div class="mrpItem">
                      <div class="mrp">
                        <h6>MRP:</h6>
                        <div>
                          {% assign addon_price = item.properties["Add On Price"] %}
                          {% if addon_price %}
                            {% assign addon_price_paise = addon_price | times: 100 %}
                            {% assign addon_total = item.final_line_price | plus: addon_price_paise %}
                            <span>&#8377;</span><span>{{ addon_total | money_without_currency | split: '.' | first }}</span>
                          {% else %}
                            <span>&#8377;</span><span>{{ item.final_line_price | money_without_currency | split: '.' | first }}</span>
                          {% endif %}
                        </div>
                      </div>
                      <p>(Inclusive all of taxes)</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

                  <div class="col-12 col-md-5 col-lg-4 col-xl-4 offset-xl-1">
                      <div class="order__summary__wrapper">
                       {% assign total_mrp = 0 %}
                          {% for item in cart.items %}
                            {% assign addon_price = item.properties["Add On Price"] %}
                            {% if addon_price %}
                              {% assign addon_price_paise = addon_price | times: 100 %}
                              {% assign addon_total = item.final_line_price | plus: addon_price_paise %}
                              {% assign total_mrp = total_mrp | plus: addon_total %}
                            {% else %}
                              {% assign total_mrp = total_mrp | plus: item.final_line_price %}
                            {% endif %}
                          {% endfor %}

                          <h3>Order Summary</h3>
                          <div class="product_mrp_flex">
                             <div class="inner_flex">
                                <div class="item">MRP ({{ cart.item_count }} Products)</div>
                                <div class="rate">
                                  <span>&#8377;</span><span id="orderMrp">{{ total_mrp | money_without_currency | split: '.' | first }}</span>
                                </div>
                              </div>

                              <div class="inner_flex">
                                  <div class="item">Shipping</div>
                                  <div class="rate">Free</div>
                              </div>
                          </div>

                          <div class="availability_wrap">
                              <h4>Check availability for installation</h4>
                              
                              <div class="pinCode">
                                <input type="text" id="pincodeInput" class="controls" placeholder="Pin code" maxlength="6" inputmode="numeric">
                                <div class="successText" style="display:none;">Installation service is available.</div>
                                <div class="errorText" style="display:none;">Installation service is unavailable.</div>
                              </div>

                              <div class="installation">
                                <div class="checkbox_wrap">
                                  <div class="checkbox">
                                    <input type="checkbox" name="checkboxs" id="checkboxs" class="cstm-chk">
                                    <label for="checkboxs">Add Installation Fee</label>
                                  </div>
                                  <div class="tooltip_wrap">
                                    <img src="{{ 'img_cart_Info.svg' | asset_url }}" class="info" alt="" />
                                   
                                    <div class="tooltipText">
                                            {{ shop.metafields.custom.installation_tooltip }}
                                            <a href="javascript:void();" data-bs-toggle="modal"
                                                data-bs-target="#modalTooltip">Read More.</a>
                                        </div>
                                  </div>
                                </div>
                                <div class="installationFee">
                                  <span>&#8377;</span><span id="installationFeeValue">0</span>
                                </div>
                              </div>
                            </div>



                          <div class="total_price_flex">
                              <div class="total">
                                  <h4>Total</h4>
                                  <div>
                                      <span>&#8377;</span><span id="totalValue">{{ initial_total_cents | money_without_currency | split: '.' | first }}</span>
                                  </div>
                              </div>

                           
                          </div>


                          <div class="floation_button">
                              <!-- Only for Mobile (Desktop screen not required only its show in mobile) -->
                              <div class="mrpMobile">
                                  <h4>
                                      <span class="mrp">MRP</span>
                                      <span>&#8377;</span><span id="mrpMobileValue">{{ initial_total_cents | money_without_currency | split: '.' | first }}</span>
                                  </h4>
                              </div>
                              <!-- Only for Mobile -->
                              <a href="javascript:" class="btns btnDark btnProceed" data-bs-toggle="modal"
                                  data-bs-target="#loginModal">
                                  <div class="bg"></div>
                                  <div class="btnText">
                                      <span>Proceed</span>
                                      <span>Proceed</span>
                                  </div>
                              </a>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
  </section>
  <style>
{% render 'sml-client-css' %}
</style>
{% render 'sml-main' %}
<script>
{% render 'sml-client-js' %}
</script>

