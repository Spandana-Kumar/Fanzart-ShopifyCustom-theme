<script>
document.addEventListener("DOMContentLoaded", function () {
  let resendTimerInterval;
  let otpStartTime = null;
  const otpValidDuration = 30; // seconds

  function clearOTPInputs() {
    document.querySelectorAll("#otpInputs .otpControls").forEach(i => i.value = "");
  }

  function isOtpExpired() {
    if (!otpStartTime) return true;
    const elapsed = (Date.now() - otpStartTime) / 1000;
    return elapsed > otpValidDuration;
  }

  function startResendCountdown(seconds = 30) {
    otpStartTime = Date.now(); // Reset OTP timer start
    clearInterval(resendTimerInterval);

    const counter = document.querySelector(".resendCounter");
    const timerSpan = document.getElementById("resendTimer");
    const resendText = document.querySelector(".resend_text");

    if (!counter || !timerSpan || !resendText) return;

    counter.style.display = "block";
    resendText.style.display = "none";

    let remaining = seconds;

    function updateTimer() {
      const mm = String(Math.floor(remaining / 60)).padStart(2, "0");
      const ss = String(remaining % 60).padStart(2, "0");
      timerSpan.textContent = `${mm}:${ss}`;

      if (remaining <= 0) {
        clearInterval(resendTimerInterval);
        counter.style.display = "none";
        resendText.style.display = "block";
      }
      remaining--;
    }

    updateTimer();
    resendTimerInterval = setInterval(updateTimer, 1000);
  }

  // STEP 1: Send OTP
  document.getElementById("logInNum").addEventListener("click", function () {
    const phone = document.getElementById("phone").value.trim();

    if (!/^[6-9]\d{9}$/.test(phone)) {
      document.getElementById("warningMsg").style.display = "block";
      return;
    }
    document.getElementById("warningMsg").style.display = "none";

    document.getElementById("smlPhoneNumberInput").value = phone;
    document.getElementById("getOTPButton").click();

    document.getElementById("displayNumber").innerText = phone;
    document.getElementById("logInBlock").style.display = "none";
    document.getElementById("otpBlock").style.display = "block";

    clearOTPInputs();
    startResendCountdown(30);
     
    document.querySelector('#otpInputs .otpControls')?.focus();

    const otpError = document.getElementById("otpErrorMsg");
    if (otpError) otpError.style.display = "none";
  });

  // STEP 2: Capture OTP and validate
  document.querySelectorAll("#otpInputs .otpControls").forEach((input, idx, arr) => {
    input.addEventListener("input", function () {
      if (this.value.length === 1 && idx < arr.length - 1) arr[idx + 1].focus();

      const otp = Array.from(arr).map(i => i.value).join("");

      if (otp.length === 4) {
        const otpError = document.getElementById("otpErrorMsg");

        if (isOtpExpired()) {
          otpError.style.display = "block";
          otpError.textContent = "OTP expired. Please request a new one.";
          clearOTPInputs();
          return;
        }

        otpError.style.display = "none";
        document.getElementById("otpInput").value = otp;
        document.getElementById("submitOTPButton").click();
      }
    });
  });

  // STEP 3: Email for new users
  document.getElementById("emailForm").addEventListener("submit", function (e) {
    e.preventDefault();
    const email = document.getElementById("userEmail").value.trim();
    if (!email) return;
    localStorage.setItem("sml_user_email", email);
    document.getElementById("userEmailInput").value = email;
    document.getElementById("registerUserButton").click();
  });

  // STEP 4: Edit number
  document.getElementById("editNumber").addEventListener("click", function (e) {
    e.preventDefault();
    document.getElementById("otpBlock").style.display = "none";
    document.getElementById("logInBlock").style.display = "block";
    clearOTPInputs();
    clearInterval(resendTimerInterval);
  });

  // STEP 5: Resend OTP
  document.getElementById("resendSMS").addEventListener("click", function (e) {
    e.preventDefault();
    clearOTPInputs();
    document.getElementById("resendOTPButton").click();

    otpStartTime = Date.now();
    startResendCountdown(30);

    const otpError = document.getElementById("otpErrorMsg");
    if (otpError) otpError.style.display = "none";
  });

  // STEP 6: Hook into SML events
  window.runOnSMLEvent = function (event, data) {
    console.log("SML Event:", event, data);

    if (event === "PHONE_OTP_SCREEN_TYPE_CHANGE") {
      if (data.screen_type === "ENTER_OTP") {
        document.getElementById("logInBlock").style.display = "none";
        document.getElementById("otpBlock").style.display = "block";
        clearOTPInputs();
        startResendCountdown(30);
        const otpError = document.getElementById("otpErrorMsg");
        if (otpError) otpError.style.display = "none";
      }
      if (data.screen_type === "ENTER_EMAIL") {
        document.getElementById("otpBlock").style.display = "none";
        document.getElementById("emailBlock").style.display = "block";
        clearInterval(resendTimerInterval);
      }
    }

    if (event === "LOGIN_SUCCESSFUL" || event === "USER_REGISTERED_SUCCESSFULLY") {
      if (data && data.email) {
        localStorage.setItem("sml_user_email", data.email);
      }
      localStorage.setItem("sml_login_time", Date.now());
      try {
        window.dispatchEvent(new CustomEvent('sml_user_logged_in', { detail: data || {} }));
      } catch (e) { }
      if (window.jQuery && jQuery('#loginModal').modal) {
        try { jQuery('#loginModal').modal('hide'); } catch (e) { }
      }
      try {
        if (!window.location.pathname.toLowerCase().includes('checkout')) {
      window.location.href = '/checkout';
        }
      } catch (e) { }
    }
  };

  // STEP 7: AJAX OTP failure
  if (window.jQuery) {
    jQuery(document).ajaxError(function (event, jqxhr, settings, thrownError) {
      if (settings && settings.url && settings.url.includes("validateOTP")) {
        console.error("OTP API error caught:", jqxhr);
        const otpError = document.getElementById("otpErrorMsg");
        if (otpError) {
          otpError.style.display = "block";
          otpError.textContent = "Invalid or expired OTP. Please try again.";
        }
        clearOTPInputs();
      }
    });
  }

  // STEP 8: Timeout fallback
  document.getElementById("submitOTPButton").addEventListener("click", function () {
    
    setTimeout(() => {
      const otpBlock = document.getElementById("otpBlock");
      if (otpBlock && otpBlock.style.display !== "none") {
        const otpError = document.getElementById("otpErrorMsg");
        if (otpError) {
          otpError.style.display = "block";
          otpError.textContent = "Invalid or expired OTP. Please try again.";
        }
      }
    }, 4000);
  });

  // STEP 9: Guest checkout
  document.getElementById("guestCheckoutBtn").addEventListener("click", function (e) {
    e.preventDefault();
    window.location.href = "/checkout";
  });
});
</script>


<!-- Autofill email at checkout -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  const storedEmail = localStorage.getItem("sml_user_email");
  if (!storedEmail) return;

  function fillEmail() {
    const emailInput = document.querySelector(
      'input#checkout_email, input#email, input[name="checkout[email]"]'
    );
    if (emailInput && !emailInput.value) {
      emailInput.value = storedEmail;
      emailInput.dispatchEvent(new Event("input", { bubbles: true }));
      console.log("Email autofilled:", storedEmail);
      return true;
    }
    return false;
  }

  // Try immediately
  if (fillEmail()) return;

  // Fallback: observe DOM changes until email field is available
  const observer = new MutationObserver(() => {
    if (fillEmail()) {
      observer.disconnect();
    }
  });

  observer.observe(document.body, { childList: true, subtree: true });
});
</script>






<script>
  let toastTimeout;
  let recentlyRemovedProduct = null;
  let removeTimeout;

  function handleRemoveClick() {
    const productId = document.getElementById("remove-product-id").value;

    // Get current item directly from the DOM instead of window.cart
    const itemEl = document.querySelector(`[data-product-id="${productId}"]`);
    const productCard = itemEl.closest('.product_card');

    // Store for undo
    recentlyRemovedProduct = {
      key: productId,
      element: productCard.cloneNode(true),
      quantity: productCard.querySelector("input[name=quantity]").value
    };

    // Hide item from DOM (visually removed)
    productCard.style.display = 'none';

    // Show toast
    undoToast();

    // After 5s, actually remove it from Shopify cart
    removeTimeout = setTimeout(() => {
      removeFromCart();
    }, 5000);
  }

  function removeFromCart() {
    if (!recentlyRemovedProduct) return;

    const form = document.createElement("form");
    form.method = "post";
    form.action = "/cart/change";

    form.innerHTML = `
      <input type="hidden" name="id" value="${recentlyRemovedProduct.key}">
      <input type="hidden" name="quantity" value="0">
    `;

    document.body.appendChild(form);
    form.submit(); // reloads cart
  }

  function undoToast() {
    const toast = document.getElementById("toast");
    toast.style.display = "block";

    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toast.style.display = "none";
    }, 5000);
  }

  function hideToast() {
    const toast = document.getElementById("toast");
    toast.style.display = "none";
    clearTimeout(toastTimeout);
  }

  function undoAction() {
    hideToast();
    clearTimeout(removeTimeout);

    const cartColumn = document.querySelector('.cart__wrapper .container .row .col-12');
    const cartTitle = cartColumn.querySelector('.cart_title');

    if (recentlyRemovedProduct && recentlyRemovedProduct.element) {
      recentlyRemovedProduct.element.style.display = '';

      // Insert after cart_title
      cartTitle.insertAdjacentElement('afterend', recentlyRemovedProduct.element);
    }

    recentlyRemovedProduct = null;
  }


  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll(".remove-btn").forEach(button => {
      button.addEventListener("click", () => {
        const productId = button.getAttribute("data-product-id");
        const title = button.getAttribute("data-product-title");
        const image = button.getAttribute("data-product-image");
        const price = button.getAttribute("data-product-price");

        document.getElementById("modal-product-title").textContent = title;
        document.getElementById("modal-product-image").src = image;
        document.getElementById("modal-product-price").textContent = price;
        document.getElementById("remove-product-id").value = productId;
      });
    });
  });
document.addEventListener("DOMContentLoaded", function () {
  function updateStockButtons() {
    // Group by tracking key
    const groupedQuantities = {};

    document.querySelectorAll(".product_card").forEach(card => {
      const key = card.getAttribute("data-tracking-key");
      const qty = parseInt(card.querySelector("input[name=quantity]").value) || 0;

      groupedQuantities[key] = (groupedQuantities[key] || 0) + qty;
    });

    // Loop through all increase buttons
    document.querySelectorAll(".increase").forEach(btn => {
      const key = btn.getAttribute("data-tracking-key");
      const available = parseInt(btn.getAttribute("data-available"));
      const totalInCart = groupedQuantities[key] || 0;

      if (totalInCart >= available) {
        btn.disabled = true;
      } else {
        btn.disabled = false;
      }
    });
  }

  // Function to update Shopify cart
  function updateCart(line, quantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, quantity: quantity })
    })
    .then(res => res.json())
    .then(data => {
      console.log("Cart updated:", data);
      updateStockButtons();

      // Fetch fresh cart to compute MRP including any add-on properties
      fetch('/cart.js')
        .then(r => r.json())
        .then(cartData => {
          var mrpCents = 0;
          (cartData.items || []).forEach(function(it){
            var itemTotal = parseInt(it.final_line_price || 0, 10) || 0;
            var addon = 0;
            if (it.properties && it.properties['Add On Price']) {
              var parsed = parseFloat(it.properties['Add On Price']);
              if (!isNaN(parsed)) addon = Math.round(parsed * 100);
            }
            mrpCents += itemTotal + addon;
          });

          computeAndRenderTotals(mrpCents);
        })
        .catch(e => console.error('Error fetching cart.js for totals', e));
    })
    .catch(err => console.error("Cart update error:", err));
  }

  // Attach events for + and -
  document.querySelectorAll(".increase").forEach(btn => {
    btn.addEventListener("click", function () {
      const card = this.closest(".product_card");
      const input = card.querySelector("input[name=quantity]");
      const line = card.getAttribute("data-line");

      let qty = parseInt(input.value) || 0;
      qty++;

      input.value = qty;
      updateCart(line, qty);
    });
  });

  document.querySelectorAll(".decrease").forEach(btn => {
    btn.addEventListener("click", function () {
      const card = this.closest(".product_card");
      const input = card.querySelector("input[name=quantity]");
      const line = card.getAttribute("data-line");

      let qty = parseInt(input.value) || 0;
      if (qty > 1) qty--;

      input.value = qty;
      updateCart(line, qty);
    });
  });

  // Run initial
  updateStockButtons();
});
 const installationFeesStr = '{{ shop.metafields.custom.installation_pincodes }}';
  
  // Parse it safely in JS
  let windowInstallationFees = {};
  try {
    windowInstallationFees = JSON.parse(installationFeesStr);
  } catch(e) {
    console.error("Invalid JSON in installation pincodes metafield:", e);
  }

  window.installationFees = windowInstallationFees;
const pincodeInput = document.getElementById("pincodeInput");
const successText = document.querySelector(".successText");
const errorText = document.querySelector(".errorText");
const installationFeeEl = document.getElementById("installationFeeValue");
const installationDiv = document.querySelector('.installation');
const installationCheckbox = document.getElementById('checkboxs'); // ✅ correct ID

let installationFee = 0;

// Hide initially
installationDiv.style.display = "none";
installationCheckbox.disabled = true;

function validatePincode() {
  const value = pincodeInput.value.replace(/\D/g, '').trim();

  if (/^\d{6}$/.test(value)) {
    if (window.installationFees && window.installationFees[value]) {
      // ✅ Installation available
      successText.style.display = "block";
      errorText.style.display = "none";
      installationDiv.style.display = "flex";
      installationCheckbox.disabled = false;

      installationFee = parseInt(window.installationFees[value]);
      installationFeeEl.textContent = installationFee.toLocaleString("en-IN");
    } else {
      // ❌ Not available
      successText.style.display = "none";
      errorText.style.display = "block";
      installationDiv.style.display = "none";
      installationCheckbox.checked = false;
      installationCheckbox.disabled = true;
      installationFee = 0;
      installationFeeEl.textContent = "0";
    }
  } else {
    // ⚠️ Invalid pincode
    successText.style.display = "none";
    errorText.style.display = "none";
    installationDiv.style.display = "none";
    installationCheckbox.checked = false;
    installationCheckbox.disabled = true;
    installationFee = 0;
    installationFeeEl.textContent = "0";
  }

  window.computeAndRenderTotals?.(currentOrderMrpCents);
}

pincodeInput.addEventListener("input", validatePincode);

// Add dynamic totals calculation: include installation in displayed total
(function(){
  // initial order MRP in cents from Liquid
  var currentOrderMrpCents = {{ total_mrp | default: 0 }};

  function formatRupees(num) {
    try { return Number(num).toLocaleString('en-IN'); } catch (e) { return num; }
  }

  // orderMrpCents expected in cents
  window.computeAndRenderTotals = function(orderMrpCents) {
    if (typeof orderMrpCents !== 'number') orderMrpCents = Number(orderMrpCents) || 0;
    currentOrderMrpCents = orderMrpCents;

    var orderMrpRupees = Math.round(orderMrpCents / 100);
    var installCheckbox = document.getElementById('checkboxs');
    var installation = (installCheckbox && installCheckbox.checked && typeof installationFee === 'number') ? installationFee : 0;

    // Displayed order MRP = products only
    var displayedOrderMrp = orderMrpRupees;

    // Total = products + installation (shipping always free, no "you save")
    var total = Math.round(orderMrpRupees + installation);
    if (total < 0) total = 0;

    var orderEl = document.getElementById('orderMrp');
    if (orderEl) orderEl.textContent = formatRupees(displayedOrderMrp);

    var totalEl = document.getElementById('totalValue');
    if (totalEl) totalEl.textContent = formatRupees(total);

    var mobileEl = document.getElementById('mrpMobileValue');
    if (mobileEl) mobileEl.textContent = formatRupees(total);
  };

  // recompute shortly after pincode validation updates installationFee
  var pincodeEl = document.getElementById('pincodeInput');
  if (pincodeEl) {
    pincodeEl.addEventListener('input', function(){
      setTimeout(function(){ window.computeAndRenderTotals(currentOrderMrpCents); }, 50);
    });
  }

  // recompute when installation checkbox toggles
  var installationCheckbox = document.getElementById('checkboxs');
  if (installationCheckbox) {
    installationCheckbox.addEventListener('change', function(){
      window.computeAndRenderTotals(currentOrderMrpCents);
    });
  }

  // compute on initial load
  document.addEventListener('DOMContentLoaded', function(){
    window.computeAndRenderTotals(currentOrderMrpCents);
  });
})();


</script>


