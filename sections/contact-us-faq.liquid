<section class="faq__wrapper">
  <div class="container">
    <h2 class="title42">{{ section.settings.heading }}</h2>
    <div class="row">
      <div class="col-12 col-lg-4">
        <ul class="tabs">
          {% for block in section.blocks %}
            <li class="{% if forloop.first %}active{% endif %}" rel="tab{{ forloop.index }}">
              {{ block.settings.tab_title }}
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="col-12 col-lg-8">
        <div class="tab_container">
          {% for block in section.blocks %}
            <h3 class="tab_drawer_heading {% if forloop.first %}d_active{% endif %}" rel="tab{{ forloop.index }}">
              {{ block.settings.tab_title }}
            </h3>
            <div id="tab{{ forloop.index }}" class="tab_content" {% unless forloop.first %}style="display:none"{% endunless %}>
              <div class="accordion" id="accordion-{{ forloop.index }}">
                {% for i in (1..20) %}
                  {% assign question_key = "question_" | append: i %}
                  {% assign answer_key = "answer_" | append: i %}
                  {% if block.settings[question_key] != blank %}
                    <div class="accordion-item">
                      <h2 class="accordion-header">
                        <button class="accordion-button {% unless forloop.index0 == 0 %}collapsed{% endunless %}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ forloop.parentloop.index }}-{{ i }}" aria-expanded="{% if forloop.index0 == 0 %}true{% else %}false{% endif %}" aria-controls="collapse-{{ forloop.parentloop.index }}-{{ i }}">
                          {{ block.settings[question_key] }}
                        </button>
                      </h2>
                      <div id="collapse-{{ forloop.parentloop.index }}-{{ i }}" class="accordion-collapse collapse {% if forloop.index0 == 0 %}show{% endif %}" data-bs-parent="#accordion-{{ forloop.parentloop.index }}">
                        <div class="accordion-body">
                          {{ block.settings[answer_key] }}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

