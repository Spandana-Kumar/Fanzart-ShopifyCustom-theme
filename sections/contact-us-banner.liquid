<section class="contact__banner__wrapper">

{% if section.settings.bg_image %}
  <img src="{{ section.settings.bg_image | image_url }}" class="bg d-none d-md-block" alt="" />
{% endif %}
{% if section.settings.bg_image_mobile %}
  <img src="{{ section.settings.bg_image_mobile | image_url }}" class="bg d-block d-md-none" alt="" />
{% endif %}

  
  <div class="floating_contents_wrap">
    <div class="title">
      <h1 class="title56 txtWhite">{{ section.settings.heading }}</h1>
      <p class="font_20 txtWhite">{{ section.settings.subheading }}</p>
    </div>

    <div class="details_wrap">
      <div class="card_flex">
        {% for block in section.blocks %}
          <div class="cards">
            <img src="{{ block.settings.icon | image_url }}" alt="" />
            <p>{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
   <section class="contact__form__wrapper">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-12 col-lg-10">

        {% form 'contact', id: 'contactForm' %}
          <div class="form_group">
            <label for="">I am a <sup>*</sup></label>
            <div class="radio_flex">
              <div class="radio_wrap">
                <input type="radio" id="radio1" name="contact[role]" value="Customer" checked>
                <label for="radio1">Customer </label>
              </div>
              <div class="radio_wrap">
                <input type="radio" id="radio2" name="contact[role]" value="Architect">
                <label for="radio2">Architect</label>
              </div>
              <div class="radio_wrap">
                <input type="radio" id="radio3" name="contact[role]" value="Interior Designer">
                <label for="radio3">Interior Designer </label>
              </div>
              <div class="radio_wrap">
                <input type="radio" id="radio4" name="contact[role]" value="Dealer">
                <label for="radio4">Dealer</label>
              </div>
              <div class="radio_wrap">
                <input type="radio" id="radio5" name="contact[role]" value="Other">
                <label for="radio5">Other</label>
              </div>
            </div>
            <div class="errorMsg">Please select the type of user</div>
          </div>

          <div class="flex_input_wrap">
            <div class="form_group">
              <label for="name">Name<sup>*</sup></label>
              <input type="text" id="name" class="formControl" name="contact[name]" placeholder="Enter name">
              <div class="errorMsg"></div>
            </div>
            <div class="form_group">
              <label for="email">Email<sup>*</sup></label>
              <input type="text" class="formControl" id="email" name="contact[email]" placeholder="Enter email">
              <div class="errorMsg"></div>
            </div>
            <div class="form_group">
              <label for="phone">Phone Number<sup>*</sup></label>
              <input type="text" class="formControl" id="phone" name="contact[phone]" placeholder="Enter phone">
              <div class="errorMsg"></div>
            </div>
            <div class="form_group">
              <label for="city">City / Pin Code<sup>*</sup></label>
              <input type="text" class="formControl" id="city" name="contact[city]" placeholder="Enter city / pin code">
              <div class="errorMsg"></div>
            </div>
            <div class="form_group">
              <label for="preferredMode">Preferred Contact Mode</label>
              <input type="text" id="preferredMode" class="formControl" name="contact[preferredMode]" placeholder="Select the mode of contact">
              <div class="errorMsg"></div>
            </div>
            <div class="form_group">
              <label for="reason">Reason for Contact</label>
              <input type="text" id="reason" class="formControl" name="contact[reason]" placeholder="Select the reason">
              <div class="errorMsg"></div>
            </div>
            <div class="form_group full-grid">
              <label for="msg">Message</label>
              <textarea name="contact[body]" placeholder="Write a message"></textarea>
              <div class="errorMsg"></div>
            </div>
            <div class="form_group full-grid">
              <input type="checkbox" name="chkbox" id="chkbox" class="cstm-chk">
              <label for="chkbox">I agree to be contacted by Fanzart.</label>
              <div class="errorMsg"></div>
            </div>
            <div class="btn-group full-grid">
              <button type="submit" class="btns btnDark">
                <div class="bg"></div>
                <div class="btnText">
                  <span>Submit</span>
                  <span>Submit</span>
                </div>
              </button>
            </div>
          </div>
        {% endform %}

        {% if form.posted_successfully? %}
          <div class="thankYouMsg" id="successMsg" style="display:block;">
            <div class="inner_wrap">
              <button class="close-btn">
                <img src="../assets/img/icons/x.svg" alt="">
              </button>
              <h4>Thanks for reaching out! We've received your message and will get back to you soon.</h4>
            </div>
          </div>
        {% else %}
          <div class="thankYouMsg" id="successMsg">
            <div class="inner_wrap">
              <button class="close-btn">
                <img src="../assets/img/icons/x.svg" alt="">
              </button>
              <h4>Thanks for reaching out! We've received your message and will get back to you soon.</h4>
            </div>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</section>



{% schema %}
{
  "name": "Contact Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fans Built for Luxury"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything That Makes Us Worth Your Ceiling"
    }
  ],
  "blocks": [
    {
      "type": "icon_text",
      "name": "Icon Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Card description"
        }
      ]
    }
  ],
  "max_blocks": 5,

}
{% endschema %}
