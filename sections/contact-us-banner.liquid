{% schema %}
{
  "name": "Contact Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fans Built for Luxury"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything That Makes Us Worth Your Ceiling"
    }
  ],
  "blocks": [
    {
      "type": "icon_text",
      "name": "Icon Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Card description"
        }
      ]
    }
  ],
  "max_blocks": 5,

}
{% endschema %}
