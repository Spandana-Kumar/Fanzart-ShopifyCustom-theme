<script>
    document.addEventListener("DOMContentLoaded", () => {
        const dropdown = document.querySelector(".customDropdown");
        const selected = dropdown.querySelector(".selected");
        const options = dropdown.querySelectorAll(".options li");
        const productWrapper = document.querySelector(".listing__card__wrapper");

        // Function to sort current page products
        function sortProducts(type) {
            const cards = Array.from(productWrapper.querySelectorAll(".listing_card"));

            cards.sort((a, b) => {
                const priceA = parseFloat(a.querySelector(".priceValue").textContent.replace(/,/g, ""));
                const priceB = parseFloat(b.querySelector(".priceValue").textContent.replace(/,/g, ""));

                if (type === "price-ascending") {
                    return priceA - priceB; // Low → High
                } else if (type === "price-descending") {
                    return priceB - priceA; // High → Low
                }
                return 0;
            });

            // Put sorted cards back
            cards.forEach(card => productWrapper.appendChild(card));
        }

    // Initialization: respect server-side active option if present.
    // If an option already has the 'active' class (rendered server-side via collection.sort_by),
    // use that option and apply sorting. Otherwise show a non-selectable placeholder 'Sort by'
    // and do not auto-sort the current page.
    const activeOption = Array.from(options).find(opt => opt.classList.contains('active'));
    if (activeOption) {
      selected.textContent = activeOption.textContent.trim();
      sortProducts(activeOption.dataset.value);
    } else {
      selected.textContent = 'Sort by';
    }

        // Toggle dropdown
        selected.addEventListener("click", () => {
            dropdown.classList.toggle("open");
            selected.classList.toggle("open");
        });

        // Select option
        options.forEach(option => {
            option.addEventListener("click", () => {
                options.forEach(opt => opt.classList.remove("active"));
                option.classList.add("active");
                selected.textContent = option.textContent;
                dropdown.classList.remove("open");
                selected.classList.remove("open");

                // Sort based on selected option
                sortProducts(option.dataset.value);
            });
        });

        // Close dropdown if clicking outside
        document.addEventListener("click", (e) => {
            if (!dropdown.contains(e.target)) {
                dropdown.classList.remove("open");
                selected.classList.remove("open");
            }
        });
    });

</script>




    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (window.innerWidth >= 767) {
                const cards = document.querySelectorAll(".listing_card");
                const outOfStock = document.querySelectorAll(".outOfStock");
                cards.forEach(card => {
                    const lifestyleImg = card.querySelector(".lifestyleImg");
                    const magicImgs = card.querySelectorAll(".magicImg img");
                    const colorOptions = card.querySelectorAll(".colorFlex .colorImg");
                    const defaultImg = card.querySelector(".magicImg .defaultImg");
                    const productDetails = card.querySelector(".product_details");
                    const hiddenDetails = card.querySelector(".hiddenDetails");
                    const colorTitleFlex = card.querySelector(".colorTitleFlex");
                    let selectedSrc = (defaultImg.dataset && defaultImg.dataset.src) ? defaultImg.dataset.src : defaultImg.getAttribute("src"); // Default selected
                    const originalSrc = selectedSrc; // keep original for restore on mouseleave
                    // Helper: Hide all magic images
                    function hideAllMagicImages() {
                        magicImgs.forEach(img => {
                            img.classList.remove("show");
                            img.classList.add("hide");
                        });
                    }
                    // Show selected image in magicImg
                    // showSelectedImage(optionalSrc) - if optionalSrc provided, show that src without modifying selectedSrc
                    function showSelectedImage(optionalSrc) {
                        const srcToShow = optionalSrc || selectedSrc;
                        hideAllMagicImages();
                        lifestyleImg.classList.remove("show");
                        lifestyleImg.classList.add("hide");
                        const targetImg = Array.from(magicImgs).find(img => (img.dataset && img.dataset.src ? img.dataset.src : img.getAttribute("src")) === srcToShow);
                        if (targetImg) {
                            targetImg.classList.remove("hide");
                            targetImg.classList.add("show");
                        } else if (srcToShow) {
                            // fallback: set the defaultImg src to the srcToShow and show it
                            try {
                                defaultImg.setAttribute('src', srcToShow);
                                if (defaultImg.dataset) defaultImg.dataset.src = srcToShow;
                                defaultImg.classList.remove('hide');
                                defaultImg.classList.add('show');
                            } catch (e) {
                                // ignore
                            }
                        }
                    }
                    // Initial state
                    showSelectedImage();
                    // Hover on card: show hover image (second magic image) if present, otherwise show lifestyle image
                    card.addEventListener("mouseenter", function () {
                        productDetails.classList.add("floating");
                        hiddenDetails.classList.add("expend");
                        colorTitleFlex.classList.add("hidden");
                        // try to find hover image inside magicImgs (prefer element with class 'colorImg')
                        const hoverImg = card.querySelector('.magicImg .colorImg');
                        if (hoverImg) {
                            hideAllMagicImages();
                            // hide lifestyle
                            lifestyleImg.classList.remove("show");
                            lifestyleImg.classList.add("hide");
                            // show hover
                            hoverImg.classList.remove("hide");
                            hoverImg.classList.add("show");
                        } else {
                            // fallback: show lifestyle image
                            lifestyleImg.classList.remove("hide");
                            lifestyleImg.classList.add("show");
                            hideAllMagicImages();
                        }
                    });
                    // On leave: restore the original default image (hover is temporary)
                    card.addEventListener("mouseleave", function () {
                        // Restore image
                        showSelectedImage(originalSrc);
                        // Set first color as active (default) when coming back from hover
                        const firstColor = colorOptions && colorOptions.length ? colorOptions[0] : null;
                        if (firstColor) {
                            // reset active classes
                            colorOptions.forEach(opt => opt.classList.remove('active'));
                            firstColor.classList.add('active');
                            // update selectedSrc to first color's target (but we won't show it, image remains original)
                            const swatchImg = firstColor.querySelector('img');
                            let firstTarget = '';
                            if (swatchImg && swatchImg.dataset && swatchImg.dataset.targetSrc) firstTarget = swatchImg.dataset.targetSrc;
                            else if (firstColor.dataset && firstColor.dataset.targetSrc) firstTarget = firstColor.dataset.targetSrc;
                            else if (swatchImg) firstTarget = swatchImg.getAttribute('src');
                            if (firstTarget) selectedSrc = firstTarget;
                            // update sizes for the first color
                            try {
                                const variantsJsonEl = card.querySelector('.product-variants-json');
                                if (variantsJsonEl) {
                                    const variants = JSON.parse(variantsJsonEl.textContent || '[]');
                  const selectedColor = firstColor.dataset.color || (firstColor.textContent || '').trim();
                                    const sizes = [];
                                    variants.forEach(v => {
                                        const vColor = (v.option1 || '').toString();
                                        const vSize = (v.option2 || '').toString();
                                        if (vColor.toLowerCase() === selectedColor.toLowerCase()) {
                                            if (vSize && sizes.indexOf(vSize) === -1) sizes.push(vSize);
                                        }
                                    });
                                    const sizeUl = card.querySelector('.size');
                                    if (sizeUl) {
                                        sizeUl.innerHTML = '';
                                        if (sizes.length === 0) {
                                            const li = document.createElement('li');
                                            li.classList.add('active');
                                            li.textContent = '-';
                                            sizeUl.appendChild(li);
                                        } else {
                                            sizes.forEach((s, idx) => {
                                                const li = document.createElement('li');
                                                if (idx === 0) li.classList.add('active');
                                                // keep raw size for logic and show trimmed version to user
                                                li.dataset.rawSize = s;
                                                li.textContent = (function(raw){
                                                    try{
                                                        const m = raw.match(/\(([^)]+)\)/);
                                                        if(m && m[1]) return m[1].trim();
                                                        const parts = raw.split('-');
                                                        return parts.length>1? parts[parts.length-1].trim(): raw.trim();
                                                    }catch(e){return raw;}
                                                })(s);
                                                sizeUl.appendChild(li);
                                            });
                                        }
                    // After updating sizes, also update the displayed price to match the restored first color (and first size if present)
                    try {
                      const activeLi = sizeUl.querySelector('li.active');
                      const selectedSizeRaw = activeLi && (activeLi.dataset && activeLi.dataset.rawSize) ? activeLi.dataset.rawSize : (activeLi ? activeLi.textContent : null);
                      updateCardPrice(card, variants, { color: selectedColor, size: selectedSizeRaw });
                    } catch (err) {
                      // ignore price update errors
                    }
                                    }
                                }
                            } catch (e) {
                                // ignore
                            }
                        }
                        productDetails.classList.remove("floating");
                        colorTitleFlex.classList.remove("hidden");
                        hiddenDetails.classList.remove("expend");
                    });
                    // Click on color options
                    colorOptions.forEach(option => {
                        option.addEventListener("click", function (evt) {
                            // prevent any anchor or parent handlers from navigating/refreshing
                            evt.preventDefault();
                            evt.stopPropagation();
                            // Remove active class from all and set on clicked
                            colorOptions.forEach(opt => opt.classList.remove("active"));
                            this.classList.add("active");
                            // Get the target image source (prefer data-target-src on swatch img)
                            const swatchImg = this.querySelector("img");
                            let targetSrc = '';
                            if (swatchImg && swatchImg.dataset && swatchImg.dataset.targetSrc) {
                                targetSrc = swatchImg.dataset.targetSrc;
                            } else {
                                // fallback: if swatch contains data-target-src attribute itself (e.g., swatchFallback)
                                if (this.dataset && this.dataset.targetSrc) targetSrc = this.dataset.targetSrc;
                                else if (swatchImg) targetSrc = swatchImg.getAttribute("src");
                            }
                            if (targetSrc) {
                                selectedSrc = targetSrc;
                            }
                            showSelectedImage();
                            // Update size list: find variants JSON and filter by selected color
                            try {
                                const variantsJsonEl = card.querySelector('.product-variants-json');
                                if (variantsJsonEl) {
                                    const variants = JSON.parse(variantsJsonEl.textContent || '[]');
                                    const selectedColor = option.dataset.color || (option.textContent || '').trim();
                                    const sizes = [];
                                    variants.forEach(v => {
                                        const vColor = (v.option1 || '').toString();
                                        const vSize = (v.option2 || '').toString();
                                        if (vColor.toLowerCase() === selectedColor.toLowerCase()) {
                                            if (vSize && sizes.indexOf(vSize) === -1) sizes.push(vSize);
                                        }
                                    });
                                    // Update the size list markup (ul.size)
                                    const sizeUl = card.querySelector('.size');
                                    if (sizeUl) {
                                        sizeUl.innerHTML = '';
                                        if (sizes.length === 0) {
                                            const li = document.createElement('li');
                                            li.classList.add('active');
                                            li.textContent = '-';
                                            sizeUl.appendChild(li);
                                        } else {
                                            sizes.forEach((s, idx) => {
                                                const li = document.createElement('li');
                                                if (idx === 0) li.classList.add('active');
                                                li.dataset.rawSize = s;
                                                li.textContent = (function(raw){
                                                    try{
                                                        const m = raw.match(/\(([^)]+)\)/);
                                                        if(m && m[1]) return m[1].trim();
                                                        const parts = raw.split('-');
                                                        return parts.length>1? parts[parts.length-1].trim(): raw.trim();
                                                    }catch(e){return raw;}
                                                })(s);
                                                sizeUl.appendChild(li);
                                            });
                                        }
                                    }
                                    // Update price when color is selected
                                    updateCardPrice(card, variants, { color: selectedColor });
                                }
                            } catch (e) {
                                // ignore JSON parse errors
                            }
                        });
                    });

                    // Listen for size (sweep) clicks to update price
                    const sizeContainer = card.querySelector('.size');
                    if (sizeContainer) {
                        sizeContainer.addEventListener('click', function (ev) {
                            const targetLi = ev.target.closest('li');
                            if (!targetLi) return;
                            // set active
                            Array.from(sizeContainer.querySelectorAll('li')).forEach(li => li.classList.remove('active'));
                            targetLi.classList.add('active');
                            try {
                                const variantsJsonEl = card.querySelector('.product-variants-json');
                                if (variantsJsonEl) {
                                    const variants = JSON.parse(variantsJsonEl.textContent || '[]');
                                    const activeColorEl = card.querySelector('.colorFlex .colorImg.active');
                                    const selectedColor = activeColorEl ? (activeColorEl.dataset.color || activeColorEl.textContent.trim()) : null;
                                    // prefer rawSize data when present (used for matching variants), fallback to visible text
                                    const selectedSize = targetLi.dataset && targetLi.dataset.rawSize ? targetLi.dataset.rawSize.trim() : targetLi.textContent.trim();
                                    updateCardPrice(card, variants, { color: selectedColor, size: selectedSize });
                                }
                            } catch (e) { /* ignore */ }
                        });
                    }
                    outOfStock.forEach(outOfStockCard => {
                        outOfStockCard.addEventListener("mouseenter", function () {
                            showSelectedImage();
                            productDetails.classList.remove("floating");
                            colorTitleFlex.classList.remove("hidden");
                            hiddenDetails.classList.remove("expend");
                        });
                    })
                });
            }
        });
    </script>

    <script>
    // Toggle 'indicatorGreen' on filter link when any filter is active
    (function(){
      function filtersAreActive(){
        try {
          // any checked checkboxes/radios inside filter groups
          var anyChecked = document.querySelectorAll('.accordion-body input[type="checkbox"]:checked, .accordion-body input[type="radio"]:checked').length > 0;
          if (anyChecked) return true;

          // price slider: if present and not default (assumes slider sets hidden inputs or updates UI)
          var priceSlider = document.getElementById('price-slider');
          if (priceSlider && window.noUiSlider && priceSlider.noUiSlider) {
            try {
              var vals = priceSlider.noUiSlider.get();
              // default in this theme is [0,200000]
              if (Array.isArray(vals)) {
                var a = Number(String(vals[0]).replace(/[^0-9.-]/g,'')) || 0;
                var b = Number(String(vals[1]).replace(/[^0-9.-]/g,'')) || 200000;
                if (a > 0 || b < 200000) return true;
              }
            } catch(e) {}
          }

          // filterAdded tags
          var filterTags = document.querySelectorAll('.filterAdded > span').length > 0;
          if (filterTags) return true;

        } catch (e) {}
        return false;
      }

      function updateFilterIndicator(){
        var el = document.getElementById('filterLinkToggle');
        if (!el) return;
        if (filtersAreActive()) el.classList.add('indicatorGreen'); else el.classList.remove('indicatorGreen');
      }

      // wire common events that can change filters
      document.addEventListener('change', function(e){
        if (e.target && (e.target.matches('.accordion-body input[type="checkbox"]') || e.target.matches('.accordion-body input[type="radio"]'))) updateFilterIndicator();
      }, true);

      // price slider change: if noUiSlider present, listen for 'change' on its instance
      document.addEventListener('DOMContentLoaded', function(){
        var ps = document.getElementById('price-slider');
        if (ps && ps.noUiSlider && typeof ps.noUiSlider.on === 'function'){
          ps.noUiSlider.on('change', updateFilterIndicator);
        }
        // also observe DOM changes in .filterAdded (tags added/removed)
        var fa = document.querySelector('.filterAdded');
        if (fa) {
          var mo = new MutationObserver(updateFilterIndicator);
          mo.observe(fa, { childList: true, subtree: true });
        }

        // initial check
        updateFilterIndicator();
      });

      // Also update when pagination or other scripts modify DOM
      window.addEventListener('popstate', updateFilterIndicator);
    })();
    </script>

    <script>
        // Helper: update displayed price on a product card based on selected color/size
        function updateCardPrice(card, variants, opts) {
            try {
                opts = opts || {};
                const color = (opts.color || '').toString().trim().toLowerCase();
                const size = (opts.size || '').toString().trim().toLowerCase();
                // Filter matching variants by provided attributes. If an attribute is empty, it's ignored.
                let matches = variants.filter(v => {
                    const vColor = (v.option1 || '').toString().trim().toLowerCase();
                    const vSize = (v.option2 || '').toString().trim().toLowerCase();
                    if (color && vColor !== color) return false;
                    if (size && vSize !== size) return false;
                    return true;
                });
                // If no matches found and color provided, fall back to color-only matches, then to any available variant
                if (matches.length === 0 && color) {
                    matches = variants.filter(v => (v.option1 || '').toString().trim().toLowerCase() === color);
                }
                if (matches.length === 0) matches = variants.slice();

                // Pick lowest price among matches
                let lowest = null;
                matches.forEach(v => {
                    // Variant price may be provided in different shapes (string/number, cents or units).
                    let priceRaw = v.price || v.compare_at_price || v.presentment_price || 0;
                    let price = Number(priceRaw);
                    if (isNaN(price)) {
                        // try parsing string with decimal
                        price = parseFloat((priceRaw || '').toString().replace(/[^0-9.\-]/g, '')) || 0;
                    }
                    // Heuristic: if price looks like cents (divisible by 100 and > 1000), convert to units
                    if (price >= 1000 && Math.round(price) % 100 === 0) {
                        price = price / 100;
                    }
                    if (lowest === null || price < lowest) lowest = price;
                });
                if (lowest === null) return; // nothing to show

                // price value element
                const priceEl = card.querySelector('.priceValue');
                if (!priceEl) return;

                // Format INR without currency symbol and without decimals (match existing markup)
                const formatted = Math.round(lowest).toLocaleString('en-IN');
                priceEl.textContent = formatted;
            } catch (e) {
                // ignore failures
            }
        }
    </script>


