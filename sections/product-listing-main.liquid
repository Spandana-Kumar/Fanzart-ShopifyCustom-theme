<!-- Banner -->
<section class="wishlist_banner">
  <div class="container">
    <div class="wishlist_banner_cont">
      
      <!-- Breadcrumb -->
      <nav class="breadcrumb_wrap">
        <ul>
          <li>
            <a href="{{ routes.root_url }}" class="breadcrumb_link">Home</a>
          </li>

          {% if collection.metafields.custom.parent_collection %}
            {% assign parent_handle = collection.metafields.custom.parent_collection | handleize %}
            <li>
              <a href="/collections/{{ parent_handle }}" class="breadcrumb_link">
                {{ collection.metafields.custom.parent_collection }}
              </a>
            </li>
          {% endif %}

          <li class="active">
            <span>{{ collection.title }}</span>
          </li>
        </ul>
      </nav>

      <!-- Title -->
      <h1 class="title42 text-center">{{ collection.title }}</h1>
    </div>
  </div>
</section>

<!-- No Results First, Then Products -->
{% if collection.products_count == 0 %}
  <section class="no_result_wrapper">
    <div class="container">
      <h1 class="title32">No Results..</h1>
      <p>Sorry there are no products available matching your filters.</p>
    </div>
  </section>
{% else %}
   <section class="wishlist_product_list">
        <div class="wishlist_product_list_innn">
            <div class="container">
                <div class="wishlist_product_list_top_sticky">

                    <div class="wishlist_product_list_top">
            <a href="javascript:;" id="filterLinkToggle" class="filterLink">
                            <img src="{{ 'img_icons_filter-icon.svg' | asset_url }}" alt="">
                            <span>Filters</span>
                        </a>
                        <div class="wishlist_product_top_right">
                                    <span class="res-num">{{ collection.products_count }} Results</span>

                                    <div class="customDropdown">
                                      <div class="selected">
                                        {% case collection.sort_by %}
                                          {% when "price-ascending" %}
                                           
                                              Price (Low - High)
                                          {% when "price-descending" %}
                                            Price (High - Low)
                                          {% else %}
                                            Sort by
                                        {% endcase %}
                                      </div>
                                      <ul class="options">
                                        <li 
                                          data-value="price-ascending" 
                                          class="{% if collection.sort_by == 'price-ascending' %}active{% endif %}">
                                         Price (Low - High)
                                        </li>
                                        <li 
                                          data-value="price-descending" 
                                          class="{% if collection.sort_by == 'price-descending' %}active{% endif %}">
                                          
                                           Price (High - Low)
                                        </li>
                                      </ul>
                                    </div>
                                  </div>

                       <!-- filter -->
       <div class="filter_outer">
    <div class="filter-sidebar">
        <div class="filter-header">
            <span>Filter</span>
            <button class="close-filter">×</button>
        </div>

        <!-- Dynamic Facets from Search & Discovery App -->
        {% if collection.filters.size > 0 %}
            {% for filter in collection.filters %}
                <div class="filter-group accordion {% if forloop.first %}open{% endif %}">
                    <div class="accordion-header">
                        {{ filter.label }}
                        <span class="selected-count"></span>
                    </div>
                    <div class="accordion-body" {% unless forloop.first %}style="display:none"{% endunless %}>
                        {% for value in filter.values %}
                            <label>
                                <input type="checkbox" 
                                       id="filter-{{ filter.param_name }}-{{ forloop.index }}" 
                                       data-filter="{{ filter.param_name }}" 
                                       value="{{ value.value }}" 
                                       {% if value.active %}checked{% endif %} 
                                       {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                                {{ value.label }}
                                {% if value.count %}<span>{{ value.count }}</span>{% endif %}
                            </label>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <p>No filters available</p>
        {% endif %}

        <!-- Price Range -->
        <div class="filter-group accordion">
            <div class="accordion-header">Price Range <span class="selected-count"></span></div>
            <div class="accordion-body" style="display:none">
                <div class="price-range">
                    <div id="price-slider"></div>
                    <div class="price-inputs">
                        <input type="text" id="price-min" readonly>
                        <input type="text" id="price-max" readonly>
                    </div>
                </div>
            </div>
        </div>

