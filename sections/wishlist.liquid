      const mobileCancelBtn = document.getElementById("mobileCancelBtn");
      const mobileRenameCreateBtn = renameInput_modal.querySelector(".btns.btnDark");
      const mobileRenameInput = renameInput_modal.querySelector(".mobileInput");
      const body = document.querySelector("body");
      let mobileRenameFolderIdx = null;

      // Open rename modal and set folder index
      mobileReanmeBtn.addEventListener("click", function () {
        renameInput_modal.classList.add("open");
        renameRemove_modal.classList.remove("show");
        body.classList.add("bgOverlay");
        // Set input value only
        const folders = JSON.parse(localStorage.getItem('wishlist_folders')||'[]');
        mobileRenameFolderIdx = window.selectedFolderIndex || 0;
        if (folders[mobileRenameFolderIdx]) {
          mobileRenameInput.value = folders[mobileRenameFolderIdx].name;
        } else {
          mobileRenameInput.value = '';
        }
      // (No-op here) - modal title update handled by top-level listener to keep behavior consistent
      });

