// Universal Add to Cart function
window.addToCart = function(variantId, quantity = 1, options = {}) {
  if (!variantId) return alert("This product cannot be added to cart (missing variant ID).");

  const properties = {};
  for (let key in options) {
    if (options[key]) properties[key] = options[key];
  }

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      id: variantId,
      quantity: quantity,
      properties: properties
    })
  })
  .then(res => res.ok ? res.json() : Promise.reject("Add to cart failed"))
  .then(data => { window.location.href = '/cart'; })
  .catch(err => { console.error(err); alert("Sorry, could not add this product to cart."); });
};

// Attach click listeners to all add-to-cart buttons
// Event delegation for dynamically generated Add to Cart buttons
document.addEventListener('click', function(e) {
  const btn = e.target.closest('.add-to-cart-btn');
  if (!btn) return;

  // silently ignore clicks on disabled/out-of-stock buttons
  if (btn.classList.contains('disabled') || btn.getAttribute('aria-disabled') === 'true') return;

  const variantId = btn.dataset.variantId;
  const options = {
    Color: btn.dataset.optionColor || '',
    Sweep: btn.dataset.optionSweep || '',
    Watt: btn.dataset.optionWatt || '',
    Material: btn.dataset.optionMaterial || '',
    Light: btn.dataset.optionLight || '',
    Mount: btn.dataset.optionMount || '',
    Addon: btn.dataset.optionAddon || ''
  };

  addToCart(variantId, 1, options);
});




