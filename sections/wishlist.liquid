  // Move a product to another folder/project
window.moveProduct = function(fromFolderIdx, productIdx, toFolderIdx) {
  const folders = getFolders();

  if (!folders[fromFolderIdx] || !folders[toFolderIdx]) return; // safety check
  if (fromFolderIdx === toFolderIdx) return; // no move if same folder

  const product = folders[fromFolderIdx].products[productIdx];
  if (!product) return;

  // Remove product from original folder
  folders[fromFolderIdx].products.splice(productIdx, 1);

  // Add product to target folder
  folders[toFolderIdx].products.push(product);

  // Save updated folders
  saveFolders(folders);

  // Re-render folders and selected products
  renderFolders();
  renderFolderProducts(selectedFolderIndex);
// Show toast message
  const fromFolderName = folders[fromFolderIdx]?.name || 'Source Folder';
  const toFolderName = folders[toFolderIdx]?.name || 'Target Folder';
  showToast(`Product moved from "${fromFolderName}" to "${toFolderName}"`);

};

