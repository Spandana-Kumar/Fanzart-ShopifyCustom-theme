          } else {
            document.getElementById('wishlistCreate').style.display = 'block';
          }
        }, 300);
      }
      renderFolders();
      // If folders exist, show products for the first folder by default
      if (folders.length > 0) {
        renderFolderProducts(0);
        renderMobileFoldersDropdown();
        renderMobileFolderProducts(0);
      }
      return;
    }
    // If no folders and no pending, show empty wishlist
    showSection(wishlistEmpty);
  }

  // initial render
  // Responsive initial render for products
  function renderResponsiveProducts() {
    if (window.innerWidth > 991) {
      document.getElementById('folderProducts').style.display = 'block';
      document.getElementById('mobileFolderProducts').style.display = 'none';
      renderFolderProducts(selectedFolderIndex);
    } else {
      document.getElementById('folderProducts').style.display = 'none';
      document.getElementById('mobileFolderProducts').style.display = 'block';
      renderMobileFoldersDropdown();
      renderMobileFolderProducts(selectedFolderIndex);
    }
  }

  renderWishlist();
  renderResponsiveProducts();

  // Listen for window resize to toggle product views
  window.addEventListener('resize', function() {
    renderResponsiveProducts();
  });

  // Listen for custom event dispatched by login-modal on successful login
  window.addEventListener('sml_user_logged_in', function(e) {
    userEmail = localStorage.getItem('sml_user_email');
    loginTimestamp = localStorage.getItem('sml_login_time');
    // If the login timestamp isn't set yet due to timing, poll briefly (up to 2s)
    // for sml_login_time before concluding.
    function finalizeLogin() {
      loginTimestamp = localStorage.getItem('sml_login_time');
      isLoggedIn = !!(loginTimestamp && (Date.now() - loginTimestamp < session24hrs));
      // Hide login screen explicitly
      var loginSection = document.getElementById('wishlistLogin');
      if (loginSection) loginSection.style.display = 'none';
      renderWishlist();
    }

    if (loginTimestamp) {
      finalizeLogin();
      return;
    }

    // Poll for up to 2 seconds
    let attempts = 0;
    const maxAttempts = 10;
    const poll = setInterval(() => {
      attempts++;
      if (localStorage.getItem('sml_login_time')) {
        clearInterval(poll);
        finalizeLogin();
      } else if (attempts >= maxAttempts) {
        clearInterval(poll);
        // fallback: ensure UI shows login prompt (not stuck)
        isLoggedIn = false;
        renderWishlist();
      }
    }, 200);
  });

  // Also handle storage events (another tab)
  window.addEventListener('storage', function(e) {
    if (e.key === 'sml_user_email' || e.key === 'sml_login_time' || e.key === 'wishlist') {
      userEmail = localStorage.getItem('sml_user_email');
      loginTimestamp = localStorage.getItem('sml_login_time');
      // rely on login timestamp alone for logged-in state (OTP-only flows)
      isLoggedIn = !!(loginTimestamp && (Date.now() - loginTimestamp < session24hrs));
      renderWishlist();
    }
  });

  // For demo: helper to add dummy items when not present (dev only)
  document.addEventListener('click', function(e) {
    const t = e.target;
    if (t && t.matches && t.matches('.add-demo-wishlist')) {
      const demo = JSON.parse(localStorage.getItem('wishlist')||'[]');
      demo.push({ title: 'Sample Product ' + (demo.length+1), variant: 'Default' });
      localStorage.setItem('wishlist', JSON.stringify(demo));
      renderWishlist();
    }
  });
});
</script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const dropdown = document.getElementById("renameRemove_modal");
    const button = document.getElementById("renameRemoveBtn");
    const body = document.querySelector("body");

    document.addEventListener("click", function (event) {
      const isClickInsideDropdown = dropdown.contains(event.target);
      const isClickOnButton = button.contains(event.target);

      if (!isClickInsideDropdown && !isClickOnButton) {
        dropdown.classList.remove("show");
        body.classList.remove("bgOverlay");
      }
    });
  });
</script>
