        renameInput_modal.classList.remove("open");
        body.classList.remove("bgOverlay");
      });

      // Create button updates folder name
      mobileRenameCreateBtn.addEventListener("click", function () {
        const newName = mobileRenameInput.value.trim() || 'Untitled';
        const folders = JSON.parse(localStorage.getItem('wishlist_folders')||'[]');
        if (folders[mobileRenameFolderIdx]) {
          folders[mobileRenameFolderIdx].name = newName;
          localStorage.setItem('wishlist_folders', JSON.stringify(folders));
          // Refresh UI for both desktop and mobile
          if (typeof renderFolders === 'function') renderFolders();
          if (typeof renderMobileFoldersDropdown === 'function') renderMobileFoldersDropdown();
          if (typeof renderMobileFolderProducts === 'function') renderMobileFolderProducts(mobileRenameFolderIdx);
          // Force update active name in dropdown immediately
          var activeName = document.getElementById('mobileActiveListName');
          if (activeName) activeName.textContent = newName;
          // Also update desktop folder name if visible
          var desktopList = document.getElementById('foldersList');
          if (desktopList) {
            var items = desktopList.getElementsByClassName('wishlistItem');
            if (items && items[mobileRenameFolderIdx]) {
              var nameSpan = items[mobileRenameFolderIdx].querySelector('.itemName');
