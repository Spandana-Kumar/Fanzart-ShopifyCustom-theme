   <script>
        document.addEventListener("DOMContentLoaded", function () {
          const button = document.getElementById("createWhislistBtn");
          const box = document.getElementById("createWishList_modal");
          const cancelBtn = document.getElementById("cancelBtn");
          const body = document.querySelector("body");
          const input = box.querySelector(".wishlistInput");
          const errorMsg = box.querySelector(".wishlist-error-msg") || (() => {
            let msg = document.createElement('p');
            msg.className = 'wishlist-error-msg text-danger hidden';
            msg.style.marginTop = '5px';
            msg.style.fontSize = '13px';
            input.parentNode.appendChild(msg);
            return msg;
          })();

        button.addEventListener("click", function () {
          box.classList.toggle("show");
          body.classList.toggle("bgOverlay");
          input.value = '';
          errorMsg.classList.add('hidden');
          input.classList.remove('error');
          // Always refresh dropdown when opening modal
          if (typeof renderMobileFoldersDropdown === 'function') renderMobileFoldersDropdown();
        });

          cancelBtn.addEventListener("click", function () {
            box.classList.remove("show");
            body.classList.remove("bgOverlay");
          });

          // Create button logic for mobile
          const createBtn = box.querySelector(".btns.btnDark");
          if (createBtn) {
            createBtn.addEventListener("click", function () {
              const name = input.value.trim();
              let folders = JSON.parse(localStorage.getItem('wishlist_folders') || '[]');
              errorMsg.classList.add('hidden');
              input.classList.remove('error');
              if (!name) {
                errorMsg.textContent = 'Please enter a project name.';
                errorMsg.classList.remove('hidden');
                input.classList.add('error');
                return;
              }
              const duplicate = folders.some(f => f.name.toLowerCase() === name.toLowerCase());
              if (duplicate) {
                errorMsg.textContent = 'Project name already exists!';
                errorMsg.classList.remove('hidden');
                input.classList.add('error');
                return;
              }
              const newFolder = { id: Date.now(), name: name, products: [] };
              const pending = JSON.parse(localStorage.getItem('wishlist_pending_product') || 'null');
              if (pending) {
                newFolder.products.push(pending);
                localStorage.removeItem('wishlist_pending_product');
              }
              folders.push(newFolder);
              localStorage.setItem('wishlist_folders', JSON.stringify(folders));
              input.value = '';
              input.classList.remove('error');
              errorMsg.classList.add('hidden');
              box.classList.remove("show");
              body.classList.remove("bgOverlay");
              // Re-render UI
              if (typeof renderFolders === 'function') renderFolders();
              if (typeof renderMobileFoldersDropdown === 'function') renderMobileFoldersDropdown();
              if (typeof renderMobileFolderProducts === 'function') renderMobileFolderProducts(folders.length - 1);
              // Always show toast after creating a project
              if (typeof showToast === 'function') showToast(`Project "${name}" created successfully`);
            });
          }
        });
    </script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  
  // Mobile customSelect dropdown toggle logic
  const mobileCustomSelect = document.querySelector('.mobileOnly .customSelect');
  const mobileSelected = mobileCustomSelect ? mobileCustomSelect.querySelector('.selected') : null;
  const mobileOptions = mobileCustomSelect ? mobileCustomSelect.querySelector('.options') : null;

  if (mobileSelected && mobileOptions) {
    mobileSelected.addEventListener('click', function(e) {
      e.stopPropagation();
      // Always refresh dropdown when opening
      if (typeof renderMobileFoldersDropdown === 'function') renderMobileFoldersDropdown();
      mobileSelected.classList.toggle('active');
      mobileOptions.classList.toggle('show');
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.customSelect')) {
        mobileSelected.classList.remove('active');
        mobileOptions.classList.remove('show');
      }
    });
  }
   // folders/lists storage format: { id, name, products: [{title,variant,...}] }
  function getFolders() { return JSON.parse(localStorage.getItem('wishlist_folders')||'[]'); }
  function saveFolders(f) { localStorage.setItem('wishlist_folders', JSON.stringify(f)); }

  let toastTimeout;
  let lastRemovedFolder = null;
  let lastRemovedIndex = null;
  let folderToRemoveIndex = null;
  // Track currently selected folder index and expose to window for other handlers
  let selectedFolderIndex = 0;
  window.selectedFolderIndex = 0;
  // ===== Product removal variables =====
let productToRemove = null;
let productToRemoveFolder = null;
let productToRemoveIndex = null;
let lastRemovedProduct = null;
let lastRemovedFromFolder = null;
let lastRemovedProductIndex = null;

// Open Remove Product modal
window.removeProduct = function(folderIdx, productIdx) {
  const folders = getFolders();
  const product = folders[folderIdx].products[productIdx];
  if (!product) return;

  // Save selected product for modal confirmation
  productToRemove = product;
  productToRemoveFolder = folderIdx;
  productToRemoveIndex = productIdx;

  // Populate modal with product info
  document.getElementById('removeProductImg').src = product.image || '../assets/img/wishlist-create/product.png';
  document.getElementById('removeProductTitle').textContent = product.title;
  document.getElementById('removeProductDesc').textContent = product.description || '';
  document.getElementById('removeProductPrice').textContent = product.price || '';

  // Show modal (Bootstrap)
  const modalEl = document.getElementById('removeProductModal');
  if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
  }
};

// Confirm product removal from modal
document.getElementById('confirmRemoveProduct').addEventListener('click', function() {
  if (productToRemove === null || productToRemoveFolder === null || productToRemoveIndex === null) return;

  const folders = getFolders();

  // Save for undo
  lastRemovedProduct = productToRemove;
  lastRemovedFromFolder = productToRemoveFolder;
  lastRemovedProductIndex = productToRemoveIndex;

  // Remove product
  folders[productToRemoveFolder].products.splice(productToRemoveIndex, 1);
  saveFolders(folders);

  // Re-render UI
  renderFolderProducts(productToRemoveFolder);
  renderFolders();
   renderMobileFolderProducts(selectedFolderIndex);
  renderMobileFoldersDropdown();

  // Show toast
  showToast("Product removed from wishlist");

  // Clear temporary modal vars
  productToRemove = null;
  productToRemoveFolder = null;
  productToRemoveIndex = null;
});

  


  // Show Toast (local helper)
function showToast(message) {
  const toast = document.getElementById("toast");
  if (!toast) return;

  // Set dynamic message
  const p = document.getElementById("toastMessage");
  if (p) p.textContent = message;

  toast.style.display = "block";
  toast.classList.add('show'); // Ensure toast is visible

  clearTimeout(window.toastTimeout);
  window.toastTimeout = setTimeout(() => {
    hideToast();
  }, 3000);
}

// Make showToast globally available
window.showToast = showToast;




 // expose hideToast globally (used by inline onclick)
window.hideToast = function() {
  const toast = document.getElementById("toast");
  if (!toast) return;
  toast.style.display = "none";
  clearTimeout(toastTimeout);

  const folders = getFolders();
  const wishlistFolders = document.getElementById("wishlistFolders");
  const wishlistEmpty = document.getElementById("wishlistEmpty");

 if (folders.length === 0) {
  wishlistFolders.style.display = "none";
  wishlistEmpty.style.display = "block";
} else {
  wishlistEmpty.style.display = "none";
  wishlistFolders.style.display = "block";
  selectedFolderIndex = 0;   // ✅ auto-select first folder
  renderFolders();
  renderFolderProducts(selectedFolderIndex);
}
};


// expose undoAction globally (used by inline onclick)
  window.undoAction = function() {
  // hide toast immediately
  window.hideToast();

  // Undo folder removal
    if (lastRemovedFolder !== null && lastRemovedIndex !== null) {
    const folders = getFolders();
    const insertIndex = Math.min(Math.max(0, lastRemovedIndex), folders.length);
    folders.splice(insertIndex, 0, lastRemovedFolder);
    saveFolders(folders);

    renderFolders();
      // Restore selection to the restored folder
      selectedFolderIndex = insertIndex;
      window.selectedFolderIndex = selectedFolderIndex;
      renderFolderProducts(insertIndex);
      renderMobileFoldersDropdown();
      renderMobileFolderProducts(insertIndex);

    document.getElementById("wishlistEmpty").style.display = "none";
    document.getElementById("wishlistFolders").style.display = "block";

    lastRemovedFolder = null;
    lastRemovedIndex = null;
    return;
  }

  // Undo product removal
  if (lastRemovedProduct !== null && lastRemovedFromFolder !== null) {
    const folders = getFolders();
    if (folders[lastRemovedFromFolder]) {
      const insertIndex = Math.min(Math.max(0, lastRemovedProductIndex), folders[lastRemovedFromFolder].products.length);
      folders[lastRemovedFromFolder].products.splice(insertIndex, 0, lastRemovedProduct);
      saveFolders(folders);

      renderFolders();
      renderFolderProducts(lastRemovedFromFolder);
      renderMobileFoldersDropdown();
      renderMobileFolderProducts(lastRemovedFromFolder);
    }

    lastRemovedProduct = null;
    lastRemovedProductIndex = null;
    lastRemovedFromFolder = null;
  }
};



