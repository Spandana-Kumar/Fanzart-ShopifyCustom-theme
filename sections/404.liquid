{% comment %} Custom 404 Page with Dynamic Settings {% endcomment %}
<section class="not__found__wrapper">
  <div class="container">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | img_url: 'master' }}" alt="Not Found Image" />
    {% endif %}

    <div class="contents">
      {% if section.settings.heading %}
        <h4>{{ section.settings.heading }}</h4>
      {% endif %}

      {% if section.settings.description %}
        <p>{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.button_label %}
        <a href="{{ section.settings.button_link | default: '/' }}" class="btns btnDark" data-aos="fade-up" data-aos-duration="2000">
          <div class="bg"></div>
          <div class="btnText">
            <span>{{ section.settings.button_label }}</span>
            <span>{{ section.settings.button_label }}</span>
          </div>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Custom Page",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Not Found Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page Not Found"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The page you are looking for might have been removed, had its name changed or is temporarily unavailable."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "Back to Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/"
    }
  ],
  "presets": [
    {
      "name": "404 Custom Design",
    }
  ]
}
{% endschema %}
